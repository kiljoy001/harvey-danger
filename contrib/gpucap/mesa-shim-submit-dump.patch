+/* Print a GPU virtual address range out of the shim's fake BOs. */
+static void
+dump_gpu_range(struct shim_fd *shim_fd, uint64_t gpuva, unsigned len)
+{
+   hash_table_foreach(shim_fd->handles, entry) {
+      struct shim_bo *bo = entry->data;
+      uint64_t off;
+      unsigned i, n;
+
+      if (gpuva < bo->mem_addr || gpuva >= bo->mem_addr + bo->size)
+         continue;
+      if (bo->map == NULL) {
+         fprintf(stderr, "PANSHIM chain gpuva=%#" PRIx64
+                 " in unmapped BO %#x\n", gpuva, bo->size);
+         break;
+      }
+
+      off = gpuva - bo->mem_addr;
+      n = MIN2(len, bo->size - off);
+      fprintf(stderr, "PANSHIM chain gpuva=%#" PRIx64 " offset=%#" PRIx64
+              " len=%u\n", gpuva, off, n);
+      for (i = 0; i + 4 <= n; i += 4) {
+         uint32_t w;
+         memcpy(&w, (uint8_t *)bo->map + off + i, 4);
+         fprintf(stderr, "PANSHIM %04x: %08x\n", i, w);
+      }
+      break;
+   }
+}
+
+static int
+panfrost_ioctl_submit(int fd, unsigned long request, void *arg)
+{
+   struct drm_panfrost_submit *submit = arg;
+   struct shim_fd *shim_fd = drm_shim_fd_lookup(fd);
+
+   fprintf(stderr, "PANSHIM SUBMIT jc=%#" PRIx64 " reqs=%#x in=%u out=%u\n",
+           (uint64_t)submit->jc, submit->requirements,
+           submit->in_sync_count, submit->out_sync);
+   dump_gpu_range(shim_fd, submit->jc, 256);
+
+   return 0;
+}
+
