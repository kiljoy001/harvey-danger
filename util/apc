#!/bin/sh
# apc: Compile and link POSIX applications on Harvey OS using TCC and APEX
set -e

HARVEY="${HARVEY:-$(cd "$(dirname "$0")/.." && pwd)}"
ARCH="${ARCH:-amd64}"
TCC="${TCC:-$(command -v tcc || echo "$HARVEY/../tinycc/tcc")}"
APEX="$HARVEY/apex"

if [ ! -f "$APEX/$ARCH/lib/libap.a" ]; then
    echo "apc: building APEX libap.a first..."
    (cd "$APEX/src" && HARVEY="$HARVEY" APEX="$APEX" OS=linux ARCH="$ARCH" CC=clang make lib)
fi

exec "$TCC" -static -nostdinc -nostdlib \
    -D_SUSV2_SOURCE -D_POSIX_SOURCE -D_LIMITS_EXTENSION -DHARVEY \
    -I"$APEX/include" \
    -I"$APEX/$ARCH/include" \
    "$APEX/$ARCH/lib/crt0.o" \
    "$APEX/$ARCH/lib/crti.o" \
    "$@" \
    "$APEX/$ARCH/lib/libap.a" \
    "$HARVEY/build/libc.a" \
    "$APEX/$ARCH/lib/crtn.o"
