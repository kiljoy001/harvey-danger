#!/bin/bash
# Cross compiler driver for the Harvey/APEX target.
#
# This is the compiler CMake (and any other build system) uses when building
# software that will *run on Harvey*.  It is a thin wrapper around the host
# clang/clang++ that pins the target triple, the APEX sysroot, libc++, and the
# Harvey link recipe.
#
# Environment:
#     HARVEY        Harvey checkout (default: two levels above this script)
#     HARVEY_CXX    1 to drive clang++ (set by the generated harvey-clang++)
#     HARVEY_TARGET target triple (default x86_64-unknown-linux-elf)

set -e

selfdir=$(cd "$(dirname "$0")" && pwd)
HARVEY=${HARVEY:-$(cd "$selfdir/../.." && pwd)}
HARVEY_CXX=${HARVEY_CXX:-0}

LIBCXX="$HARVEY/build/libcxx"
APEX="$HARVEY/apex"
TARGET=${HARVEY_TARGET:-x86_64-unknown-linux-elf}

# Harvey's C++ runtime supports exceptions and RTTI.
if [ "$HARVEY_CXX" = 1 ]; then
    CC=clang++
    CXXFLAGS=(-fexceptions -frtti -D_WCHAR_T)
else
    CC=clang
    CXXFLAGS=()
fi

if [ ! -d "$LIBCXX/include/c++/v1" ]; then
    echo "harvey-cc: missing $LIBCXX/include/c++/v1" >&2
    echo "harvey-cc: run ../9vm/build_libcxx.py first" >&2
    exit 1
fi

: "${HARVEY_CLANG_RESOURCE:=$(clang -print-resource-dir)/include}"

compile_only=0
asm_only=0
for arg in "$@"; do
    case "$arg" in
        *.s|*.S|*.sx)
            asm_only=1
            ;;
        -c|-E|-S|-M|-MM|-fsyntax-only|--version|-dumpversion|-dumpmachine|--help|-print-*)
            compile_only=1
            ;;
    esac
done

if [ "$asm_only" = 1 ]; then
    exec "$CC" -target "$TARGET" "$@"
fi

FLAGS=(
    -target "$TARGET"
    -static
    -nostdinc
    -fno-stack-protector
    -mno-red-zone
    -D_SUSV2_SOURCE -D_POSIX_SOURCE -D_LIMITS_EXTENSION -D_GNU_SOURCE -DHARVEY
    -I"$selfdir/target-include"
    -I"$LIBCXX/include/c++/v1"
    -I"$LIBCXX/include"
    -include "$LIBCXX/include/compat.h"
    -I"$APEX/include"
    -I"$APEX/amd64/include"
    -isystem "$HARVEY_CLANG_RESOURCE"
)
FLAGS+=("${CXXFLAGS[@]}")

if [ "$compile_only" = 1 ]; then
    exec "$CC" "${FLAGS[@]}" "$@"
fi

# Drop host libraries that CMake adds; Harvey's libc and libc++ supply the
# equivalents, and -lpthread/-lm/-ldl would pull in glibc objects.
ARGS=()
for arg in "$@"; do
    case "$arg" in
        -lpthread|-lm|-ldl|-lrt|-lc|-lz|-lstdc++|-lgcc|-lgcc_s|--as-needed|--no-as-needed)
            continue
            ;;
    esac
    ARGS+=("$arg")
done

exec "$CC" "${FLAGS[@]}" \
    -fuse-ld=lld -nostdlib -Wl,-z,max-page-size=0x200000 \
    "${ARGS[@]}" \
    "$APEX/amd64/lib/crt0.o" \
    "$APEX/amd64/lib/crti.o" \
    "$LIBCXX/lib/libc++.a" \
    "$LIBCXX/lib/libunwind.a" \
    "$APEX/amd64/lib/libcxxabi.a" \
    "$APEX/amd64/lib/libap.a" \
    "$HARVEY/build/libc.a" \
    "$APEX/amd64/lib/crtn.o"
