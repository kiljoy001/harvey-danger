#!/bin/sh
# ucc: Unified C Compiler for Harvey OS & Plan 9
set -e

HARVEY="${HARVEY:-$(cd "$(dirname "$0")/.." && pwd)}"
ARCH="${ARCH:-amd64}"
UCC_REPO="${UCC_REPO:-$HARVEY/../ucc}"

if [ ! -x "$UCC_REPO/ucc" ]; then
    echo "ucc: binary not found at $UCC_REPO/ucc, building..." >&2
    (cd "$UCC_REPO" && make && gcc -O2 ucc.c -o ucc)
fi

export HARVEY ARCH
exec "$UCC_REPO/$(basename "$0")" "$@"
