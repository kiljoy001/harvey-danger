# Wi-Fi/BT family: Unisoc UWE5622 over SDIO (Orange Pi 3B v1.1).
#
# The chip sits on sdmmc1 (DesignWare MSHC) and carries both the cfg80211
# Wi-Fi function and a Bluetooth HCI channel exposed as a TTY.  The native
# side owns the rails, the 32 kHz clock and WL_REG_ON; the guest drivers own
# the controller registers and the SDIO function.

# MMC/SDIO and the DesignWare MSHC host
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y

# Wireless core
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_RFKILL=y

# Unisoc UWE5622: BSP, Wi-Fi and BT-over-SDIO
CONFIG_SPARD_WLAN_SUPPORT=y
CONFIG_AW_WIFI_DEVICE_UWE5622=y
CONFIG_WCN_BSP_DRIVER_BUILDIN=y
CONFIG_WLAN_UWE5622=y
CONFIG_TTY_OVERY_SDIO=y
CONFIG_BT=y

# The vendor driver reads wcnmodem.bin through filp_open; under LKL it is
# taken from the kernel's built-in firmware image instead.
CONFIG_EXTRA_FIRMWARE="uwe5622/wcnmodem.bin uwe5622/wifi_2355b001_1ant.ini"
CONFIG_EXTRA_FIRMWARE_DIR="/tmp/opencode/fw"

# rtc_time64_to_tm is used by the cfg80211/BT time paths
CONFIG_RTC_CLASS=y
