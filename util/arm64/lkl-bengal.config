# Qualcomm Snapdragon 662 / SM6115 (Bengal, Moto G Power 2021 / borneo)
# Merged over defconfig alongside lkl-usb.config and lkl-wifi.config.

# Allow ARCH_QCOM || COMPILE_TEST drivers under ARCH=lkl
CONFIG_COMPILE_TEST=y

# Clocks, reset, power domains, syscon
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_6115=y
CONFIG_QCOM_GDSC=y
CONFIG_REGMAP_MMIO=y
CONFIG_REGMAP_I2C=y
CONFIG_MFD_SYSCON=y

# Pinctrl / GPIO (TLMM + SPMI PMIC GPIOs)
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM6115=y

# SPMI PMIC Arbiter + PM6125 / PMI632 PMICs
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_SUPPLY=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_IIO=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_LM3697=y
# CONFIG_LEDS_QCOM_LPG=y

# Storage: eMMC / SD (SDHCI MSM) + UFS
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
# CONFIG_SCSI_UFSHCD=y
# CONFIG_SCSI_UFSHCD_PLATFORM=y
# CONFIG_SCSI_UFS_QCOM=y

# QUPv3 GENI (I2C, SPI, UART) + Touchscreen
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_SPIDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ILITEK_0FLASH_MMI=y
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI=y
# CONFIG_TOUCHSCREEN_ILITEK=y
# CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=y
# CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# Wi-Fi: WCN3990 (stock borneo DT: qcom,icnss@C800000, NOT the
# Unisoc UWE5622 in lkl-wifi.config -- that is the Orange Pi/Samsung
# chip, gated off Bengal by the sprd,unisoc-wifi-ott DT marker).
# Mainline stack: ath10k_snoc over QMI/QRTR over GLINK-SMEM to the
# modem; SMP2P/SMEM/mailbox are the transport.  The modem itself is
# not up under Harvey yet, so expect probe + WLFW QMI timeout, not
# association, until the modem subsystem lands.
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_PACKET=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y

# TrustZone SCM + Hexagon DSP PAS (Modem, ADSP, CDSP) + PD Mapper + RMTFS
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_RMTFS_MEM=y

# USB (Qualcomm DWC3 glue + QUSB2 PHY) (disabled for bisect)
# CONFIG_PHY_QCOM_QUSB2=y
# CONFIG_USB_DWC3_QCOM=y

# Thermal, RNG, Regulators
CONFIG_THERMAL=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_TSENS=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_QCOM_RNG=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

CONFIG_LOCALVERSION="-g1"
