# USB host stack for the LKL USB family (Orange Pi 3B / RK3566).
#
# Merged over the LKL aarch64 defconfig.  The first target is the USB2 OTG
# controller at fcc00000 in host mode; USB3 (fd000000, Naneng combphy and
# the Rockchip dwc3 glue) comes after the USB2 path is proven.
#
# Keep gadget + dummy_hcd enabled for the hardware-free test harness:
# dummy_hcd enumerates a gadget (HID or mass storage) through the real
# Linux USB core, so lklusb's /dev/input and block paths can be tested in
# QEMU before touching the board.

# Device tree and clock/PHY substrate
CONFIG_OF=y
CONFIG_COMMON_CLK=y
CONFIG_EXTCON=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# USB core, DWC3 host and the platform xHCI glue
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y

# Classes: HID (keyboard/mouse), storage, ACM
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_TTY=y
CONFIG_USB_ACM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# Hardware-free test harness (dummy_hcd + configfs gadgets)
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
