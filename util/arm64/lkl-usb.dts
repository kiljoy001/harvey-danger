/*
 * Trimmed device tree for the LKL USB family (Orange Pi 3B, RK3566).
 *
 * Two controller groups are described:
 *
 *   fcc00000  USB2 OTG (dwc3) on usb2phy0_otg -- the Type-C port.
 *   fd800000  EHCI + OHCI on usb2phy1_otg      -- USB2 Type-A host 0.
 *   fd880000  EHCI + OHCI on usb2phy1_host     -- USB2 Type-A host 1.
 *
 * The USB3 host at fd000000 also needs the Naneng combphy and the vendor
 * dwc3-rockchip glue; add it once that glue is in the LKL tree.
 *
 * The PHYs and PD_PIPE are handed over already powered by the native
 * side (U-Boot / board init); this tree only describes the windows the
 * guest drivers touch.
 */
/dts-v1/;

/ {
	compatible = "rockchip,rk3566";
	#address-cells = <2>;
	#size-cells = <2>;

	gic: interrupt-controller@fd400000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0xfd400000 0x0 0x10000>,
		      <0x0 0xfd460000 0x0 0x80000>;
		interrupt-controller;
		#interrupt-cells = <3>;
		#address-cells = <0>;
	};

	usb@fcc00000 {
		compatible = "snps,dwc3";
		reg = <0x0 0xfcc00000 0x0 0x400000>;
		interrupt-parent = <&gic>;
		interrupts = <0 169 4>;		/* GIC_SPI 169, LEVEL_HIGH */
		clocks = <&clk_ref>, <&clk_bus>, <&clk_suspend>;
		clock-names = "ref", "bus", "suspend";
		dr_mode = "host";
		maximum-speed = "high-speed";
		phy_type = "utmi_wide";
		snps,dis_u2_susphy_quirk;
		phys = <&usb2phy0_otg>;
		phy-names = "usb2-phy";
		vbus-supply = <&vbus_reg>;
		status = "okay";
	};

	/*
	 * The two USB2 host controllers drive the Type-A ports.  They are
	 * EHCI/OHCI pairs behind the usb2phy1 PHY; usbpower has already
	 * powered the PHY and the CRU gates, so the guest only needs the
	 * controller windows and the PHY node for the generic PHY lookup.
	 */
	usb@fd800000 {
		compatible = "generic-ehci";
		reg = <0x0 0xfd800000 0x0 0x40000>;
		interrupt-parent = <&gic>;
		interrupts = <0 130 4>;		/* GIC_SPI 130 */
		clocks = <&clk_bus>, <&clk_bus>, <&clk_bus>;
		phys = <&usb2phy1_otg>;
		phy-names = "usb";
		status = "okay";
	};

	usb@fd840000 {
		compatible = "generic-ohci";
		reg = <0x0 0xfd840000 0x0 0x40000>;
		interrupt-parent = <&gic>;
		interrupts = <0 131 4>;		/* GIC_SPI 131 */
		clocks = <&clk_bus>, <&clk_bus>, <&clk_bus>;
		phys = <&usb2phy1_otg>;
		phy-names = "usb";
		status = "okay";
	};

	usb@fd880000 {
		compatible = "generic-ehci";
		reg = <0x0 0xfd880000 0x0 0x40000>;
		interrupt-parent = <&gic>;
		interrupts = <0 133 4>;		/* GIC_SPI 133 */
		clocks = <&clk_bus>, <&clk_bus>, <&clk_bus>;
		phys = <&usb2phy1_host>;
		phy-names = "usb";
		status = "okay";
	};

	usb@fd8c0000 {
		compatible = "generic-ohci";
		reg = <0x0 0xfd8c0000 0x0 0x40000>;
		interrupt-parent = <&gic>;
		interrupts = <0 134 4>;		/* GIC_SPI 134 */
		clocks = <&clk_bus>, <&clk_bus>, <&clk_bus>;
		phys = <&usb2phy1_host>;
		phy-names = "usb";
		status = "okay";
	};

	usb2phy1: usb2phy@fe8b0000 {
		compatible = "rockchip,rk3568-usb2phy";
		reg = <0x0 0xfe8b0000 0x0 0x10000>;
		clocks = <&clk_phy>;
		clock-names = "phyclk";
		clock-output-names = "clk_usbphy1_480m";
		#clock-cells = <0>;
		rockchip,usbgrf = <&usb2phy1_grf>;
		status = "okay";

		usb2phy1_otg: otg-port {
			#phy-cells = <0>;
			phy-supply = <&vbus_reg>;
			status = "okay";
		};

		usb2phy1_host: host-port {
			#phy-cells = <0>;
			phy-supply = <&vbus_reg>;
			status = "okay";
		};
	};

	usb2phy1_grf: syscon@fdca8000 {
		compatible = "rockchip,rk3568-usb2phy-grf", "syscon";
		reg = <0x0 0xfdca8000 0x0 0x8000>;
	};

	usb2phy0: usb2phy@fe8a0000 {
		compatible = "rockchip,rk3568-usb2phy";
		reg = <0x0 0xfe8a0000 0x0 0x10000>;
		clocks = <&clk_phy>;
		clock-names = "phyclk";
		clock-output-names = "clk_usbphy0_480m";
		#clock-cells = <0>;
		rockchip,usbgrf = <&usb2phy0_grf>;
		status = "okay";

		usb2phy0_otg: otg-port {
			#phy-cells = <0>;
			phy-supply = <&vcc3v3>;
			status = "okay";
		};
	};

	usb2phy0_grf: syscon@fdca0000 {
		compatible = "rockchip,rk3568-usb2phy-grf", "syscon";
		reg = <0x0 0xfdca0000 0x0 0x8000>;
	};

	clk_ref: ref-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	clk_suspend: suspend-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	clk_bus: bus-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	clk_phy: phy-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <480000000>;
	};

	vcc3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * VBUS is not a fixed rail: the native usbpower service owns the
	 * GPIOs and PMU/CRU/PHY state.  The guest regulator forwards
	 * enable/disable to that service, so LKL is the control surface
	 * without the guest touching PMU/CRU registers.
	 */
	vbus_reg: regulator-vbus@0 {
		compatible = "harvey,regulator";
		reg = <0x0 0x0 0x0 0x0>;
		regulator-name = "vbus";
		harvey,path = "/srv/usbpower/ctl";
		harvey,status = "/srv/usbpower/status";
		regulator-always-on;
		regulator-boot-on;
	};
};
