-/* called from idle, don't failed, don't block */
+/* Create from init, not swapper: the idle task is not a valid fork parent. */
+static void lkl_idle_start(void)
+{
+	if (idle_host_task_started)
+		return;
+	/* Init still has to exec /init; the helper must not join its group. */
+	if (kernel_thread(idle_host_task_loop, NULL, NULL,
+			  CLONE_FS | CLONE_FILES) < 0)
+		return;
+	idle_host_task_started = 1;
+}
+
+static int __init idle_host_task_init(void)
+{
+	lkl_idle_start();
+	return idle_host_task_started ? 0 : -ENOMEM;
+}
+early_initcall(idle_host_task_init);
