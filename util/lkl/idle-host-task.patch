diff --git a/arch/lkl/kernel/syscalls.c b/arch/lkl/kernel/syscalls.c
index cd4431ff2..883abd405 100644
--- a/arch/lkl/kernel/syscalls.c
+++ b/arch/lkl/kernel/syscalls.c
@@ -139,11 +139,32 @@ long lkl_syscall(long no, long *params)
 
 static struct task_struct *idle_host_task;
 
+/*
+ * Before /init runs there is no idle host task to switch to.  Release the
+ * CPU and park this task on its own sched_sem instead: that is exactly what
+ * idle_host_task_loop() does, without creating a kernel thread from the
+ * idle path (which raced with syscalls_init() and could leave the guest
+ * holding the CPU forever).
+ */
+static void
+lkl_idle_park(void)
+{
+	struct thread_info *ti = current_thread_info();
+
+	lkl_cpu_put();
+	lkl_ops->sem_down(ti->sched_sem);
+	schedule_tail(ti->prev_sched);
+}
+
 /* called from idle, don't failed, don't block */
 void wakeup_idle_host_task(void)
 {
-	if (!need_resched() && idle_host_task)
+	if (need_resched())
+		return;
+	if (idle_host_task)
 		wake_up_process(idle_host_task);
+	else
+		lkl_idle_park();
 }
 
 static int idle_host_task_loop(void *unused)
