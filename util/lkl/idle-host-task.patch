 static struct task_struct *idle_host_task;
+static int idle_host_task_started;
+static int idle_host_task_loop(void *unused);
+
+/*
+ * Create the idle host task once the scheduler is up.  arch_cpu_idle() can
+ * only hand the CPU back to the host through this task; before /init there
+ * is nothing else that can release the CPU and still schedule, so the guest
+ * would sit in do_idle() forever.  cpu_startup_entry() calls this before
+ * entering the loop, where kernel_thread() is safe.
+ */
+void lkl_idle_start(void)
+{
+	if (idle_host_task_started)
+		return;
+	if (kernel_thread(idle_host_task_loop, NULL, NULL, CLONE_FLAGS) < 0)
+		return;
+	idle_host_task_started = 1;
+}
+
+/*
+ * Fallback if the guest idles before lkl_idle_start(): release the CPU and
+ * park this task on its own sched_sem.
+ */
+static void
+lkl_idle_park(void)
+{
+	struct thread_info *ti = current_thread_info();
+
+	lkl_cpu_put();
+	lkl_ops->sem_down(ti->sched_sem);
+	schedule_tail(ti->prev_sched);
+}
 
 /* called from idle, don't failed, don't block */
 void wakeup_idle_host_task(void)
 {
-	if (!need_resched() && idle_host_task)
+	if (need_resched())
+		return;
+	if (idle_host_task)
 		wake_up_process(idle_host_task);
+	else
+		lkl_idle_park();
 }
 
