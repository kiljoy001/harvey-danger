// Aspera's first user process. The program and GEFS server live in #/boot.
// Only the opaque image is exported by the host; no host tree is mounted.
function start_gefs_root() int64 {
    int64 result;
    c {
        char *args[] = {"gefs", "-A", "-m", "32", "-n", "asperagefs",
                        "-f", "/mnt/image", nil};
        char *dirs[] = {"/mnt/bin", "/mnt/dev", "/mnt/env", "/mnt/fd",
                        "/mnt/mnt", "/mnt/mnt/o9", "/mnt/n", "/mnt/n/o9irc",
                        "/mnt/n/devices", "/mnt/net", "/mnt/proc",
                        "/mnt/srv", "/mnt/boot", "/mnt/rom", "/mnt/lib",
                        "/mnt/lib/o9irc", "/mnt/lib/aspera", "/mnt/build",
                        "/mnt/build/aspera-live", "/mnt/mnt/o9driverfs-config",
                        "/mnt/mnt/o9drvman-status", "/mnt/rc", "/mnt/rc/lib",
                        "/mnt/n/host", nil};
        char *ircargs[] = {"o9irc-ircfs", "o9irc", "", "", "",
                           "/lib/o9irc", "262144", nil};
        char *probe = "Aspera GEFS root probe\n";
        char *milestone = "Aspera system milestone 1\n";
        char *mode;
        char buf[64];
        char icmd[96];
        int nn;
        Dir *d;
        int fd, pid, srvfd, i, n, hasApp, mounted, desktopstarted;

        result = -1;
        desktopstarted = 0;

        /* Installer mode: kernel command line contained install=1. */
        {
            char ib[4], mbuf[512], icmd[64];
            char *fmt[] = {"gefs", "-r", "glenda", "-f", "/mnt/image", nil};
            char *srv[] = {"gefs", "-A", "-m", "32", "-n", "installgefs",
                           "-f", "/mnt/image", nil};
            int ifd, k, nn, imgfd;

            ifd = open("#e/install", OREAD);
            if(ifd >= 0){
                k = read(ifd, ib, sizeof ib - 1);
                close(ifd);
            } else
                k = 0;
            if(k <= 0 || ib[0] != '1')
                goto not_installing;

            fd = open("#9/2", ORDWR);
            if(fd < 0 || mount(fd, -1, "/mnt", MREPL, "") < 0){
                print("install: image transport mount failed: %r\n");
                if(fd >= 0) close(fd);
                goto gefs_done;
            }
            print("install: GEFS image at #9/2\n");
            imgfd = open("/mnt/image", ORDWR);
            if(imgfd < 0)
                print("install: open image fd: %r\n");

            pid = rfork(RFPROC|RFFDG);
            if(pid == 0){
                exec("/boot/gefs", fmt);
                print("install: exec gefs -r failed: %r\n");
                _exits("gefs-fmt");
            }
            if(pid < 0){
                print("install: fork failed: %r\n");
                goto gefs_done;
            }
            {
                Waitmsg *w;
                w = wait();
                if(w != nil)
                    free(w);
            }

            pid = rfork(RFPROC|RFFDG|RFNOWAIT);
            if(pid == 0){
                exec("/boot/gefs", srv);
                print("install: exec gefs failed: %r\n");
                _exits("gefs-srv");
            }
            srvfd = -1;
            for(i = 0; i < 200; i++){
                srvfd = open("/srv/installgefs", OREAD);
                if(srvfd >= 0)
                    break;
                sleep(50);
            }
            if(srvfd < 0){
                print("install: GEFS did not come up on the new partition: %r\n");
                goto gefs_done;
            }
            {
                char *names[] = {"bin/rc", "bin/ls", "bin/cat", "bin/echo",
                                 "bin/test", "rc/lib/rcmain", "boot/boot", nil};
                char sp[128], dp[128], cbuf[4096];
                int sf, df, hfd, k, ncopy, nfail;
                Dir *sd;

                hfd = open("#9/0", ORDWR);
                if(hfd < 0){
                    print("install: no host tree (#9/0): %r\n");
                    close(srvfd);
                    goto gefs_done;
                }
                if(mount(hfd, -1, "/n", MREPL, "") < 0){
                    print("install: mount host tree: %r\n");
                    close(hfd);
                    close(srvfd);
                    goto gefs_done;
                }
                if(mount(srvfd, -1, "/mnt", MREPL|MCREATE, "") < 0){
                    print("install: mount new filesystem: %r\n");
                    close(srvfd);
                    goto gefs_done;
                }
                close(srvfd);

                df = create("/mnt/bin", OREAD, DMDIR|0775);
                if(df >= 0) close(df);
                df = create("/mnt/boot", OREAD, DMDIR|0775);
                if(df >= 0) close(df);
                df = create("/mnt/rc", OREAD, DMDIR|0775);
                if(df >= 0) close(df);
                df = create("/mnt/rc/lib", OREAD, DMDIR|0775);
                if(df >= 0) close(df);

                ncopy = 0;
                nfail = 0;
                for(k = 0; names[k] != nil; k++){
                    snprint(sp, sizeof sp, "/n/%s", names[k]);
                    snprint(dp, sizeof dp, "/mnt/%s", names[k]);
                    sf = open(sp, OREAD);
                    if(sf < 0){
                        print("install: open %s: %r\n", sp);
                        nfail++;
                        continue;
                    }
                    df = create(dp, OWRITE, 0775);
                    if(df < 0){
                        print("install: create %s: %r\n", dp);
                        close(sf);
                        nfail++;
                        continue;
                    }
                    while((nn = read(sf, cbuf, 4096)) > 0){
                        if(write(df, cbuf, nn) != nn){
                            print("install: write %s: %r\n", dp);
                            nfail++;
                            break;
                        }
                        ncopy += nn;
                    }
                    close(sf);
                    close(df);
                    sd = dirstat(dp);
                    if(sd != nil){
                        print("install: %s: %lld bytes\n", dp, sd->length);
                        free(sd);
                    }
                }
                print("install: copied %d bytes into the new root\n", ncopy);
                /* GEFS is write-back cached and sync() commits the tree
                 * from the active mounts: keep /mnt mounted until after
                 * the sync/halt, or the new files are never linked into
                 * the snapshot and vanish on the next boot. */
                {
                    char vb[128];
                    int cfd, vn;
                    cfd = open("/srv/installgefs.cmd", ORDWR);
                    if(cfd >= 0){
                        print("install: syncing GEFS\n");
                        write(cfd, "sync\n", 5);
                        vn = read(cfd, vb, sizeof vb - 1);
                        if(vn > 0){ vb[vn] = 0; print("install: %s", vb); }
                        write(cfd, "halt\n", 5);
                        vn = read(cfd, vb, sizeof vb - 1);
                        if(vn > 0){ vb[vn] = 0; print("install: %s", vb); }
                        close(cfd);
                        sleep(5000);
                        /* the server has exited; /mnt is stale and the
                         * verify mount below replaces it. */
                    }else
                        print("install: no GEFS control channel: %r\n");
                }
                /* Re-open the image through the held descriptor and check
                 * that the committed tree really contains the payload. */
                unmount(nil, "/mnt");
                {
                    char *ver[] = {"gefs", "-A", "-m", "8", "-n",
                                   "installverify", "-f", "/mnt/image", nil};
                    char ipath[32];
                    Dir *vd;
                    int vfd;
                    snprint(ipath, sizeof ipath, "#d/%d", imgfd);
                    ver[7] = ipath;
                    vfd = -1;
                    pid = rfork(RFPROC|RFFDG|RFNOWAIT);
                    if(pid == 0){
                        exec("/boot/gefs", ver);
                        _exits("verify");
                    }
                    for(i = 0; i < 200; i++){
                        vfd = open("/srv/installverify", OREAD);
                        if(vfd >= 0) break;
                        sleep(50);
                    }
                    if(vfd < 0)
                        print("install: verify server did not start: %r\n");
                    else if(mount(vfd, -1, "/mnt", MREPL, "") < 0)
                        print("install: verify mount failed: %r\n");
                    else {
                        vd = dirstat("/mnt/bin/rc");
                        if(vd != nil){
                            print("install: verify /bin/rc %lld bytes\n", vd->length);
                            free(vd);
                        } else
                            print("install: verify /bin/rc missing: %r\n");
                        unmount(nil, "/mnt");
                    }
                    if(vfd >= 0){
                        close(vfd);
                        vfd = open("/srv/installverify.cmd", OWRITE);
                        if(vfd >= 0){
                            write(vfd, "halt\n", 5);
                            close(vfd);
                            sleep(1000);
                        }
                    }
                }
                if(nfail == 0){
                    print("INSTALL-OK\n");
                    result = 1;
                } else
                    print("INSTALL-PARTIAL (%d files failed)\n", nfail);
            }
            goto gefs_done;
        }
    not_installing:;

        fd = open("#9/2", ORDWR);
        if(fd < 0 || mount(fd, -1, "/mnt", MREPL, "") < 0){
            print("aspera: image transport mount failed: %r\n");
            if(fd >= 0) close(fd);
            goto gefs_done;
        }
        print("aspera: GEFS root on #9/2\n");

        pid = rfork(RFPROC|RFFDG|RFNOWAIT);
        if(pid == 0){
            exec("/boot/gefs", args);
            print("aspera: embedded GEFS exec failed: %r\n");
            _exits("gefs");
        }
        if(pid < 0){
            print("aspera: GEFS fork failed: %r\n");
            goto gefs_done;
        }
        srvfd = -1;
        for(i = 0; i < 200; i++){
            srvfd = open("/srv/asperagefs", OREAD);
            if(srvfd >= 0) break;
            sleep(50);
        }
        if(srvfd < 0 || mount(srvfd, -1, "/mnt", MREPL|MCREATE, "") < 0){
            print("aspera: GEFS mount failed: %r\n");
            if(srvfd >= 0) close(srvfd);
            goto gefs_done;
        }
        for(i = 0; dirs[i] != nil; i++){
            d = dirstat(dirs[i]);
            if(d != nil){
                free(d);
                continue;
            }
            fd = create(dirs[i], OREAD, DMDIR|0775);
            if(fd < 0){
                print("aspera: mkdir %s failed: %r\n", dirs[i]);
                goto gefs_done;
            }
            close(fd);
        }
        srvfd = open("/srv/asperagefs", OREAD);
        if(srvfd < 0 || mount(srvfd, -1, "/", MREPL|MCREATE, "") < 0){
            print("aspera: root pivot failed: %r\n");
            if(srvfd >= 0) close(srvfd);
            goto gefs_done;
        }
        if(bind("#c", "/dev", MAFTER) < 0 ||
           bind("#d", "/fd", MREPL) < 0 ||
           bind("#s", "/srv", MREPL|MCREATE) < 0 ||
           bind("#e", "/env", MREPL|MCREATE) < 0 ||
           bind("#/", "/rom", MREPL) < 0 ||
           bind("#@", "/mnt/o9", MREPL|MCREATE) < 0){
            print("aspera: device namespace bind failed: %r\n");
            goto gefs_done;
        }
        /* The 9vm host filesystem over the shared 9ring, if present. */
        fd = open("#~/host", ORDWR);
        if(fd >= 0){
            if(mount(fd, -1, "/n/host", MREPL, "") < 0)
                print("aspera: host ring mount failed: %r\n");
            else
                print("aspera: mounted 9ring host at /n/host\n");
            close(fd);
        }

        d = dirstat("/mnt/o9/o9drvman-status");
        if(d == nil){
            fd = create("/mnt/o9/o9drvman-status", OREAD, DMDIR|0700);
            if(fd >= 0)
                close(fd);
        }else
            free(d);
        if(bind("/mnt/o9/o9drvman-status", "/mnt/o9drvman-status",
                MREPL|MCREATE) < 0){
            print("aspera: driver status bind failed: %r\n");
            goto gefs_done;
        }
        d = dirstat("/");
        if(d == nil || (d->mode & DMDIR) == 0){
            print("aspera: GEFS root stat failed: %r\n");
            free(d);
            goto gefs_done;
        }
        free(d);
        if(dirstat("/net") == nil){
            fd = create("/net", OREAD, DMDIR|0777);
            if(fd >= 0)
                close(fd);
        }
        fd = open("/bin/netd", OEXEC);
        if(fd >= 0){
            char *netdargs[] = {"netd", nil};
            close(fd);
            pid = rfork(RFPROC|RFFDG|RFNOWAIT);
            if(pid == 0){
                exec("/bin/netd", netdargs);
                print("aspera: exec netd: %r\n");
                _exits("exec");
            }
            fd = -1;
            for(i = 0; i < 100; i++){
                fd = open("/srv/netd", ORDWR);
                if(fd >= 0)
                    break;
                sleep(50);
            }
            if(fd >= 0 && mount(fd, -1, "/net", MREPL, "") >= 0)
                print("aspera: mounted guest /net\n");
            else {
                print("aspera: guest netd mount failed\n");
                if(fd >= 0)
                    close(fd);
            }
        }
        {
            char *driverargs[] = {"o9drvman", "o9drvman", "devices",
                                  "/bin/o9driverfs", nil};
            char *config = "name\tbackend\nconsole\t/dev/cons\n";
            Dir *managerbin = dirstat("/bin/o9drvman");
            Dir *driverbin = dirstat("/bin/o9driverfs");

            if(managerbin != nil && driverbin != nil &&
               (managerbin->mode & DMDIR) == 0 && (driverbin->mode & DMDIR) == 0){
                fd = open("/mnt/o9driverfs-config/devices.tab", OREAD);
                n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
                if(fd >= 0) close(fd);
                if(n != strlen(config) || memcmp(buf, config, n) != 0){
                    fd = create("/mnt/o9driverfs-config/devices.tab", OWRITE, 0600);
                    if(fd < 0 || write(fd, config, strlen(config)) != strlen(config)){
                        print("aspera: driver configuration failed: %r\n");
                        if(fd >= 0) close(fd);
                        free(managerbin);
                        free(driverbin);
                        goto gefs_done;
                    }
                    close(fd);
                }
                pid = rfork(RFPROC|RFFDG|RFNAMEG|RFENVG|RFREND|RFNOTEG|RFNOWAIT);
                if(pid == 0){
                    exec("/bin/o9drvman", driverargs);
                    print("aspera: driver manager exec failed: %r\n");
                    _exits("drivers");
                }
                if(pid < 0){
                    print("aspera: driver manager fork failed: %r\n");
                    free(managerbin);
                    free(driverbin);
                    goto gefs_done;
                }
                for(i = 0; i < 200; i++){
                    d = dirstat("/srv/o9drvman");
                    if(d != nil){
                        free(d);
                        d = dirstat("/srv/devices");
                        if(d != nil){
                            free(d);
                            break;
                        }
                    }
                    sleep(25);
                }
                if(i == 200){
                    print("aspera: driver services did not become ready\n");
                    free(managerbin);
                    free(driverbin);
                    goto gefs_done;
                }
                n = -1;
                for(i = 0; i < 200; i++){
                    if(i != 0)
                        unmount(nil, "/n/devices");
                    srvfd = open("/srv/devices", ORDWR);
                    mounted = srvfd < 0 ? -1 :
                        mount(srvfd, -1, "/n/devices", MREPL, "");
                    if(srvfd >= 0)
                        close(srvfd);
                    if(mounted >= 0){
                        fd = open("/n/devices/view/protocol", OREAD);
                        n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
                        if(fd >= 0) close(fd);
                        if(n == strlen("o9driverfs 1\n") &&
                           memcmp(buf, "o9driverfs 1\n", n) == 0)
                            break;
                    }
                    sleep(25);
                }
                if(n != strlen("o9driverfs 1\n") ||
                   memcmp(buf, "o9driverfs 1\n", n) != 0){
                    print("aspera: device service probe failed\n");
                    free(managerbin);
                    free(driverbin);
                    goto gefs_done;
                }
                print("ASPERA-DRIVERS-STARTED\n");
            }
            free(managerbin);
            free(driverbin);
        }
        mode = getenv("asperarcprobe");
        if(mode != nil && strcmp(mode, "1") == 0){
            char *rcargs[] = {"rc", "-c",
                "/bin/test -x /bin/aspera-live && /bin/ls -ld /bin/aspera-live && /bin/echo ASPERA-RC-PROBE PASS", nil};
            Waitmsg *w;
            pid = rfork(RFPROC|RFFDG|RFNAMEG);
            if(pid == 0){
                exec("/bin/rc", rcargs);
                print("aspera: rc exec failed: %r\n");
                _exits("rc exec");
            }
            w = pid < 0 ? nil : wait();
            if(w == nil || w->msg[0] != '\0'){
                print("aspera: rc probe failed: %r\n");
                free(w);
                free(mode);
                goto gefs_done;
            }
            free(w);
        }
        free(mode);
        mode = getenv("asperanoteprobe");
        if(mode != nil && strcmp(mode, "1") == 0){
            fd = open("/lib/aspera/smoke-note.txt", OREAD);
            n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
            if(fd >= 0) close(fd);
            if(n < 3 || memcmp(buf, "Hi!", 3) != 0){
                print("aspera: Notes persistence probe failed\n");
                free(mode);
                goto gefs_done;
            }
            print("ASPERA-NOTE-PERSIST PASS\n");
        }
        free(mode);
        mode = getenv("asperadesktop");
        if(mode != nil && strcmp(mode, "1") == 0){
            Dir *desktop = dirstat("/bin/aspera-live");
            Dir *shelf = dirstat("/bin/aspera-shelf-service");
            if(desktop == nil || shelf == nil || (desktop->mode & DMDIR) != 0 ||
               (shelf->mode & DMDIR) != 0){
                print("aspera: desktop binaries missing from GEFS /bin\n");
                free(desktop);
                free(shelf);
                free(mode);
                goto gefs_done;
            }
            free(desktop);
            free(shelf);
            fd = open("#9/0", ORDWR);
            if(fd < 0 || mount(fd, -1, "/build/aspera-live", MREPL, "") < 0){
                print("aspera: display exchange mount failed: %r\n");
                if(fd >= 0) close(fd);
                free(mode);
                goto gefs_done;
            }
            pid = rfork(RFPROC|RFFDG|RFNAMEG|RFNOWAIT);
            if(pid == 0){
                char *desktopargs[] = {"aspera-live", nil};
                exec("/bin/aspera-live", desktopargs);
                print("aspera: desktop exec failed: %r\n");
                _exits("desktop");
            }
            if(pid < 0){
                print("aspera: desktop fork failed: %r\n");
                free(mode);
                goto gefs_done;
            }
            desktopstarted = 1;
            print("ASPERA-DESKTOP-STARTED\n");
        }
        free(mode);
        mode = getenv("O9_GEFS_ROOT_TEST");
        if(mode != nil && strcmp(mode, "write") == 0){
            fd = create("/aspera-root-probe", ORDWR, 0600);
            if(fd < 0 || write(fd, probe, strlen(probe)) != strlen(probe)){
                print("aspera: root write failed: %r\n");
                if(fd >= 0) close(fd);
                free(mode);
                goto gefs_done;
            }
            close(fd);
            fd = open("/srv/asperagefs.cmd", ORDWR);
            if(fd < 0 || write(fd, "sync\n", 5) != 5){
                print("aspera: root sync failed: %r\n");
                if(fd >= 0) close(fd);
                free(mode);
                goto gefs_done;
            }
            close(fd);
            print("ASPERA-GEFS-ROOT-WRITE PASS\n");
        }
        if(mode != nil && strcmp(mode, "verify") == 0){
            fd = open("/aspera-root-probe", OREAD);
            n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
            if(fd >= 0) close(fd);
            if(n != strlen(probe) || memcmp(buf, probe, n) != 0){
                print("aspera: root verify failed: %r\n");
                free(mode);
                goto gefs_done;
            }
            print("ASPERA-GEFS-ROOT-VERIFY PASS\n");
        }
        free(mode);
        mode = getenv("O9_SYSTEM_MILESTONE_TEST");
        if(mode != nil){
            Waitmsg *w;

            d = dirstat("/n/nsprobe");
            if(d == nil){
                fd = create("/n/nsprobe", OREAD, DMDIR|0775);
                if(fd < 0){
                    print("ASPERA-SYSTEM-MILESTONE FAIL mountpoint: %r\n");
                    free(mode);
                    goto gefs_done;
                }
                close(fd);
            }else
                free(d);

            pid = rfork(RFPROC|RFFDG|RFNAMEG);
            if(pid == 0){
                fd = open("/srv/asperagefs", OREAD);
                if(fd < 0 || mount(fd, -1, "/n/nsprobe", MREPL|MCREATE, "") < 0){
                    print("aspera: namespace child A mount failed: %r\n");
                    if(fd >= 0) close(fd);
                    _exits("private mount");
                }
                d = dirstat("/n/nsprobe/lib/aspera");
                if(d == nil){
                    print("aspera: namespace child A lookup failed: %r\n");
                    _exits("private lookup");
                }
                free(d);
                print("ASPERA-NAMESPACE-CHILD-A PASS private mount visible\n");
                _exits(nil);
            }
            if(pid < 0){
                print("ASPERA-SYSTEM-MILESTONE FAIL child A: %r\n");
                free(mode);
                goto gefs_done;
            }
            w = wait();
            if(w == nil || w->pid != pid || w->msg[0] != '\0'){
                if(w == nil)
                    print("ASPERA-SYSTEM-MILESTONE FAIL child A wait: %r\n");
                else
                    print("ASPERA-SYSTEM-MILESTONE FAIL child A status pid=%d want=%d msg=%s\n",
                          w->pid, pid, w->msg);
                free(w);
                free(mode);
                goto gefs_done;
            }
            free(w);

            d = dirstat("/n/nsprobe/lib/aspera");
            if(d != nil){
                free(d);
                print("ASPERA-SYSTEM-MILESTONE FAIL parent mount leak\n");
                free(mode);
                goto gefs_done;
            }

            pid = rfork(RFPROC|RFFDG|RFNAMEG);
            if(pid == 0){
                d = dirstat("/n/nsprobe/lib/aspera");
                if(d != nil){
                    free(d);
                    _exits("mount leaked");
                }
                print("ASPERA-NAMESPACE-CHILD-B PASS private mount absent\n");
                _exits(nil);
            }
            if(pid < 0){
                print("ASPERA-SYSTEM-MILESTONE FAIL child B: %r\n");
                free(mode);
                goto gefs_done;
            }
            w = wait();
            if(w == nil || w->pid != pid || w->msg[0] != '\0'){
                if(w == nil)
                    print("ASPERA-SYSTEM-MILESTONE FAIL child B wait: %r\n");
                else
                    print("ASPERA-SYSTEM-MILESTONE FAIL child B status pid=%d want=%d msg=%s\n",
                          w->pid, pid, w->msg);
                free(w);
                free(mode);
                goto gefs_done;
            }
            free(w);
            print("ASPERA-NAMESPACE-ISOLATION PASS\n");
            if(strcmp(mode, "write") == 0){
                fd = create("/lib/aspera/system-milestone.txt", ORDWR, 0600);
                if(fd < 0 || write(fd, milestone, strlen(milestone)) != strlen(milestone)){
                    print("ASPERA-SYSTEM-MILESTONE FAIL write: %r\n");
                    if(fd >= 0) close(fd);
                    free(mode);
                    goto gefs_done;
                }
                close(fd);
                fd = open("/srv/asperagefs.cmd", ORDWR);
                if(fd < 0 || write(fd, "sync\n", 5) != 5){
                    print("ASPERA-SYSTEM-MILESTONE FAIL sync: %r\n");
                    if(fd >= 0) close(fd);
                    free(mode);
                    goto gefs_done;
                }
                close(fd);
                print("ASPERA-SYSTEM-MILESTONE-WRITE PASS\n");
            }else if(strcmp(mode, "verify") == 0){
                fd = open("/lib/aspera/system-milestone.txt", OREAD);
                n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
                if(fd >= 0) close(fd);
                if(n != strlen(milestone) || memcmp(buf, milestone, n) != 0){
                    print("ASPERA-SYSTEM-MILESTONE FAIL verify: %r\n");
                    free(mode);
                    goto gefs_done;
                }
                print("ASPERA-SYSTEM-MILESTONE-VERIFY PASS\n");
            }else{
                print("ASPERA-SYSTEM-MILESTONE FAIL invalid mode\n");
                free(mode);
                goto gefs_done;
            }
            print("ASPERA-SYSTEM-MILESTONE PASS\n");
        }
        free(mode);
        d = dirstat("/bin/o9irc-ircfs");
        hasApp = d != nil;
        free(d);
        d = hasApp ? dirstat("/rom/boot/o9irc-ircfs") : nil;
        if(hasApp && (d == nil || d->length == 0))
            print("aspera: o9irc boot binary unavailable: %r\n");
        if(d != nil && d->length > 0){
            free(d);
            pid = rfork(RFPROC|RFFDG|RFNOWAIT);
            if(pid == 0){
                exec("/rom/boot/o9irc-ircfs", ircargs);
                print("aspera: o9irc service exec failed: %r\n");
                _exits("ircfs");
            }
            if(pid < 0){
                print("aspera: o9irc service fork failed: %r\n");
                goto gefs_done;
            }
            for(i = 0; i < 100; i++){
                fd = open("/srv/o9irc", OREAD);
                if(fd >= 0) break;
                sleep(50);
            }
            if(fd < 0){
                print("aspera: o9irc service did not post /srv/o9irc\n");
                goto gefs_done;
            }
            n = -1;
            for(i = 0; i < 200; i++){
                if(i > 0){
                    fd = open("/srv/o9irc", OREAD);
                    if(fd < 0){ sleep(50); continue; }
                }
                if(mount(fd, -1, "/n/o9irc", MREPL|MCREATE, "") < 0){
                    close(fd);
                    sleep(50);
                    continue;
                }
                fd = open("/n/o9irc/view/networks/default/status", OREAD);
                n = fd < 0 ? -1 : read(fd, buf, sizeof buf);
                if(fd >= 0) close(fd);
                if(n > 0) break;
                unmount(nil, "/n/o9irc");
                sleep(50);
            }
            if(n <= 0){
                print("aspera: o9irc view status failed: %r\n");
                goto gefs_done;
            }
            print("ASPERA-O9IRC-VIEW PASS\n");
            print("ASPERA-O9IRC-SERVICE PASS\n");
        } else
            free(d);
        print("ASPERA-GEFS-ROOT PASS\n");
        result = 1;
        if(!desktopstarted){
            Dir *rcd = dirstat("/bin/rc");
            if(rcd != nil){
                char *rcargs[] = {"rc", "-i", nil};
                free(rcd);
                pid = rfork(RFPROC|RFFDG|RFNOWAIT);
                if(pid == 0){
                    exec("/bin/rc", rcargs);
                    print("aspera: rc exec failed: %r\n");
                    _exits("rc");
                } else if(pid > 0)
                    print("aspera: started /bin/rc on the console\n");
                else
                    print("aspera: rc fork failed: %r\n");
            } else
                print("aspera: no /bin/rc on the GEFS root: %r\n");
        }
    gefs_done:;
    }
    return result;
}


function stay_alive() int64 {
    c { for(;;) sleep(1000); }
    return 0;
}

main {
    Task<int64> boot = spawn start_gefs_root();
    if(boot.await() == 1) {
        Task<int64> idle = spawn stay_alive();
        idle.await();
    }
}
