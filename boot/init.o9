function raw_bind(string dev, string target, int64 flags) int64 {
    int64 res;
    c {
        char *cdev = o9_string_cstr(dev);
        char *ctgt = o9_string_cstr(target);
        res = bind(cdev, ctgt, (int)flags);
        if(res < 0){
            fprint(2, "o9-boot: bind %s -> %s failed: %r\n", cdev, ctgt);
        } else {
            print("o9-boot: bound %s -> %s\n", cdev, ctgt);
        }
        free(cdev);
        free(ctgt);
    }
    return res;
}

function raw_net_setup() int64 {
    int64 res;
    c {
        char nb[16], np[64];
        int fd, ctl, n;

        res = -1;
        if(bind("#I", "/net", MREPL) < 0){
            fprint(2, "o9-boot: bind #I -> /net failed: %r\n");
            goto out;
        }
        if(bind("#l", "/net", MAFTER) < 0)
            fprint(2, "o9-boot: no ethernet device to bind at /net\n");
        fd = open("/net/ipifc/clone", ORDWR);
        if(fd < 0){
            fprint(2, "o9-boot: open /net/ipifc/clone: %r\n");
            goto out;
        }
        n = read(fd, nb, sizeof nb - 1);
        if(n <= 0){
            fprint(2, "o9-boot: read ipifc clone: %r\n");
            close(fd);
            goto out;
        }
        nb[n] = 0;
        while(n > 0 && (nb[n-1] == '\n' || nb[n-1] == ' '))
            nb[--n] = 0;
        snprint(np, sizeof np, "/net/ipifc/%s/ctl", nb);
        ctl = open(np, OWRITE);
        if(ctl < 0){
            fprint(2, "o9-boot: open %s: %r\n", np);
            close(fd);
            goto out;
        }
        if(fprint(ctl, "bind loopback") < 0 || fprint(ctl, "add 127.0.0.1 /8") < 0){
            fprint(2, "o9-boot: loopback config: %r\n");
            close(ctl);
            close(fd);
            goto out;
        }
        close(ctl);
        /* fd stays open: it owns the interface. */
        print("o9-boot: kernel /net up (loopback 127.0.0.1/8)\n");
        res = 0;
out:
        ;
    }
    return res;
}

function raw_gefs_image_test() int64 {
    int64 result;
    c {
        char *enabled, *write_test, *isolation_test, *create_test;
        Dir *d;
        int fd, image;
        char buf[32];

        result = 0;
        enabled = getenv("O9_GEFS_IMAGE_TEST");
        if(enabled != nil && strcmp(enabled, "1") == 0){
            result = -1;
            fd = open("#9/2", ORDWR);
            if(fd < 0 || mount(fd, -1, "/mnt", MREPL, "") < 0){
                print("o9-gefs-image: FAIL mount #9/2: %r\n");
                if(fd >= 0)
                    close(fd);
            } else {
                isolation_test = getenv("O9_GEFS_IMAGE_ISOLATION_TEST");
                if(isolation_test != nil && strcmp(isolation_test, "1") == 0){
                    int other = open("/mnt/sibling", OREAD);
                    if(other >= 0)
                        print("o9-gefs-image: FAIL image isolation\n");
                    else
                        print("o9-gefs-image: PASS image isolation\n");
                    if(other >= 0) close(other);
                }
                free(isolation_test);
                create_test = getenv("O9_GEFS_IMAGE_CREATE_DENIAL_TEST");
                if(create_test != nil && strcmp(create_test, "1") == 0){
                    int other = create("/mnt/escape", ORDWR, 0600);
                    if(other >= 0){
                        print("o9-gefs-image: FAIL create isolation\n");
                        close(other);
                    } else
                        print("o9-gefs-image: PASS create isolation\n");
                }
                free(create_test);
                image = open("/mnt/image", ORDWR);
                if(image < 0){
                    print("o9-gefs-image: FAIL open image: %r\n");
                } else {
                    d = dirfstat(image);
                    if(d == nil || d->length < 128*1024*1024LL){
                        print("o9-gefs-image: FAIL image length\n");
                    } else {
                        write_test = getenv("O9_GEFS_IMAGE_WRITE_TEST");
                        if(write_test != nil && strcmp(write_test, "1") == 0){
                            if(pwrite(image, "9vm-image-write", 15, 0) != 15 ||
                               pread(image, buf, 15, 0) != 15 ||
                               memcmp(buf, "9vm-image-write", 15) != 0)
                                print("o9-gefs-image: FAIL write/read\n");
                            else{
                                print("o9-gefs-image: PASS write/read\n");
                                result = 1;
                            }
                        } else if(pread(image, buf, sizeof(buf), 0) == sizeof(buf)){
                            char *expect = getenv("O9_GEFS_IMAGE_EXPECT_MARKER");
                            if(expect != nil && strcmp(expect, "1") == 0 &&
                               memcmp(buf, "9vm-image-write", 15) != 0)
                                print("o9-gefs-image: FAIL persisted marker\n");
                            else{
                                print("o9-gefs-image: PASS read image length=%lld\n", d->length);
                                result = 1;
                            }
                            free(expect);
                        } else
                            print("o9-gefs-image: FAIL read: %r\n");
                        free(write_test);
                    }
                    free(d);
                    close(image);
                }
            }
        }
        free(enabled);
    }
    return result;
}

function raw_mount_gefs() int64 {
    int64 result;
    c {
        int disk, pid, srvfd, i;
        Dir *rootdir;
        char *image_test;
        char *args[] = {"gefs", "-A", "-m", "32", "-n", "asperagefs",
                        "-f", "/mnt/image", nil};

        result = 0;
        image_test = getenv("O9_GEFS_IMAGE_TEST");
        disk = image_test != nil && strcmp(image_test, "1") == 0 ? -1 :
               open("#9/2", ORDWR);
        free(image_test);
        if(disk >= 0){
            result = -1;
            if(mount(disk, -1, "/mnt", MREPL, "") < 0){
                print("o9-gefs: image transport mount failed: %r\n");
                close(disk);
            } else {
                pid = rfork(RFPROC|RFFDG|RFNOWAIT);
                if(pid == 0){
                    exec("/build/gefs-guest", args);
                    print("o9-gefs: server exec failed: %r\n");
                    _exits("exec");
                }
                if(pid < 0)
                    print("o9-gefs: server rfork failed: %r\n");
                else {
                    srvfd = -1;
                    for(i = 0; i < 100; i++){
                        srvfd = open("/srv/asperagefs", OREAD);
                        if(srvfd >= 0)
                            break;
                        sleep(50);
                    }
                    if(srvfd < 0)
                        print("o9-gefs: server did not post /srv/asperagefs\n");
                    else if(mount(srvfd, -1, "/mnt", MREPL|MCREATE, "") < 0){
                        print("o9-gefs: filesystem mount failed: %r\n");
                        close(srvfd);
                    } else {
                        rootdir = dirstat("/mnt");
                        if(rootdir != nil && (rootdir->mode & DMDIR) != 0){
                            print("o9-gefs: mounted persistent filesystem at /mnt\n");
                            result = 1;
                        } else
                            print("o9-gefs: mounted root stat failed: %r\n");
                        free(rootdir);
                    }
                }
            }
        }
    }
    return result;
}

function raw_bio_test(string path) int64 {
    use { bio }
    int64 len;
    c {
        Biobuf *bp;
        char *line;
        char *cpath = o9_string_cstr(path);
        len = -1;
        bp = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(bp != nil){
            line = Brdline(bp, '\n');
            if(line != nil){
                len = Blinelen(bp);
                line[len-1] = '\0';
                print("o9-bio: Brdline read %d bytes: '%s'\n", (int)len, line);
            }
            Bterm(bp);
        }
    }
    return len;
}

function raw_sleep(int64 ms) int64 {
    c {
        sleep((long)ms);
    }
    return 0;
}

function raw_idle() int64 {
    c {
        for(;;)
            sleep(10000);
    }
    return 0;
}

function raw_hostfs_rw_test() int64 {
    int64 result;
    c {
        char *enabled, *buf;
        int fd, n, i, total;

        result = 0;
        enabled = getenv("O9_HOSTFS_RW_TEST");
        if(enabled != nil && strcmp(enabled, "1") == 0){
            buf = malloc(100000);
            fd = -1;
            result = -1;
            if(buf != nil){
                for(i = 0; i < 100000; i++)
                    buf[i] = 'a' + (i % 26);
                fd = create("/n/host/build/9ring-smoke", ORDWR, 0600);
                if(fd >= 0){
                    total = 0;
                    while(total < 100000){
                        n = write(fd, buf + total, 100000 - total);
                        if(n <= 0)
                            break;
                        total += n;
                    }
                    if(total == 100000 && seek(fd, 0, 0) == 0){
                        memset(buf, 0, 100000);
                        total = 0;
                        while(total < 100000){
                            n = read(fd, buf + total, 100000 - total);
                            if(n <= 0)
                                break;
                            total += n;
                        }
                        if(total == 100000){
                            for(i = 0; i < 100000; i++)
                                if(buf[i] != 'a' + (i % 26))
                                    break;
                            if(i == 100000)
                                result = 1;
                        }
                    }
                }
            }
            if(fd >= 0){
                close(fd);
                remove("/n/host/build/9ring-smoke");
            }
            free(buf);
            if(result == 1)
                print("o9-hostfs-rw: PASS 100000-byte write/read\n");
            else
                print("o9-hostfs-rw: FAIL write/read: %r\n");
        }
        free(enabled);
    }
    return result;
}

function raw_local_9ring_test() int64 {
    int64 result;
    c {
        extern int local9ringtest(void);
        char *enabled;

        result = 0;
        enabled = getenv("O9_RING_IPC_TEST");
        if(enabled != nil && strcmp(enabled, "1") == 0)
            result = local9ringtest();
        free(enabled);
    }
    return result;
}

function raw_hostfs_bench() int64 {
    int64 result;
    c {
        char *enabled;
        char buf[16384];
        char *paths[4] = {"/n/host/README.md", "/n/host/boot/boot",
                          "/n/host/README.md", "/n/host/README.md"};
        int sizes[4] = {128, 16384, 128, 0};
        int rounds[4] = {2000, 500, 50, 500};
        int fd, item, kind, i, n, bucket, histogram[8];
        vlong start, elapsed, before, duration, sum;
        vlong cutoffs[7] = {10000, 25000, 50000, 100000,
                            250000, 500000, 1000000};

        result = 0;
        enabled = getenv("O9_HOSTFS_BENCH");
        if(enabled != nil && strcmp(enabled, "1") == 0){
            for(kind = 0; kind < 4; kind++){
                fd = open(paths[kind], OREAD);
                if(fd < 0){
                    print("o9-bench: FAIL open %s: %r\n", paths[kind]);
                    result = -1;
                    break;
                }
                for(i = 0; i < 20; i++){
                    if(kind < 3){
                        seek(fd, 0, 0);
                        read(fd, buf, sizes[kind]);
                    }
                }
                if(kind == 3){
                    close(fd);
                    fd = -1;
                }
                memset(histogram, 0, sizeof(histogram));
                sum = 0;
                print("o9-bench: begin kind=%d\n", kind);
                start = nsec();
                for(i = 0; i < rounds[kind]; i++){
                    if(kind == 2)
                        sleep(10);
                    if(kind < 3)
                        seek(fd, 0, 0);
                    before = nsec();
                    if(kind == 3){
                        item = open(paths[kind], OREAD);
                        n = item >= 0;
                        if(item >= 0)
                            close(item);
                    } else
                        n = read(fd, buf, sizes[kind]);
                    duration = nsec() - before;
                    if(n <= 0){
                        result = -1;
                        break;
                    }
                    sum += duration;
                    for(bucket = 0; bucket < 7 && duration > cutoffs[bucket]; bucket++)
                        ;
                    histogram[bucket]++;
                }
                elapsed = nsec() - start;
                if(fd >= 0)
                    close(fd);
                print("o9-bench: end kind=%d\n", kind);
                if(result < 0){
                    print("o9-bench: FAIL read kind %d: %r\n", kind);
                    break;
                }
                print("o9-bench: kind=%d count=%d bytes=%d elapsed_ns=%lld read_mean_ns=%lld bins=%d,%d,%d,%d,%d,%d,%d,%d\n",
                    kind, rounds[kind], sizes[kind], elapsed,
                    sum / rounds[kind], histogram[0], histogram[1],
                    histogram[2], histogram[3], histogram[4], histogram[5],
                    histogram[6], histogram[7]);
            }
            print("o9-bench: done\n");
        }
        free(enabled);
    }
    return result;
}

function async_worker_task(int64 task_id) int64 {
    print("o9-async: worker task ", task_id, " running concurrently\n");
    return task_id * 1000 + 42;
}

class WorkerActor {
    int64 id;
    int64 processed;

    method WorkerActor(int64 worker_id) {
        id = worker_id;
        processed = 0;
    }

    method int64 dispatch_job(int64 job_id, int64 payload) {
        processed = processed + 1;
        print("o9-worker[", id, "]: executed job ", job_id, " (payload=", payload, ", processed=", processed, ")\n");
        return payload * 2;
    }

    method int64 get_processed() {
        return processed;
    }
}

class SupervisorActor {
    int64 epoch;
    int64 heartbeats;

    method SupervisorActor(int64 start_epoch) {
        epoch = start_epoch;
        heartbeats = 0;
    }

    method void heartbeat() {
        heartbeats = heartbeats + 1;
        print("o9-supervisor: heartbeat tick ", heartbeats, " [epoch ", epoch, "]\n");
    }

    method int64 get_heartbeats() {
        return heartbeats;
    }
}

main {
    print("\n==================================================\n");
    print("  Prism Microkernel (Harvey amd64)\n");
    print("  PID 1 Objective-9C Actor Supervisor Online\n");
    print("==================================================\n");

    Task<int64> b1 = spawn raw_bind("#c", "/dev", 2);
    b1.await();
    Task<int64> b2 = spawn raw_bind("#d", "/dev", 2);
    b2.await();
    Task<int64> b3 = spawn raw_bind("#p", "/proc", 0);
    b3.await();
    Task<int64> b4 = spawn raw_bind("#s", "/srv", 4);
    b4.await();
    Task<int64> b5 = spawn raw_bind("#ec", "/env", 0);
    b5.await();
    Task<int64> b6 = spawn raw_bind("#e", "/env", 6);
    b6.await();
    Task<int64> b7 = spawn raw_bind("/", "/n/host", 0);
    b7.await();
    Task<int64> b8 = spawn raw_bind("/n/host/amd64/bin", "/bin", 2);
    b8.await();
    Task<int64> b_net = spawn raw_net_setup();
    b_net.await();

    Task<int64> disk_test = spawn raw_gefs_image_test();
    disk_test.await();

    Task<int64> disk_mount = spawn raw_mount_gefs();
    int64 disk_ready = disk_mount.await();
    if(disk_ready < 0) {
        print("o9-gefs: persistent filesystem unavailable\n");
    }

    Task<int64> bio_task = spawn raw_bio_test("/n/host/README.md");
    int64 nbytes = bio_task.await();
    print("o9-bio: verified read (nbytes = ", nbytes, ")\n");

    Task<int64> rw_task = spawn raw_hostfs_rw_test();
    rw_task.await();

    Task<int64> local_ring_task = spawn raw_local_9ring_test();
    local_ring_task.await();

    Task<int64> bench_task = spawn raw_hostfs_bench();
    bench_task.await();

    WorkerActor worker = new WorkerActor(1);
    int64 r1 = worker.dispatch_job(101, 500);
    int64 r2 = worker.dispatch_job(102, 600);
    print("o9-worker: job results r1=", r1, " r2=", r2, "\n");

    SupervisorActor sup = new SupervisorActor(1);
    sup.heartbeat();
    sup.heartbeat();

    Task<int64> async_task = spawn async_worker_task(7);
    int64 async_res = async_task.await();
    print("o9-async: awaited result = ", async_res, "\n");

    print("\n==================================================\n");
    print("  Phase 3 Self-Test Finished\n");
    print("  - Host-Passthrough Namespace: /dev, /proc, /srv, /env, /n/host\n");
    print("  - libbio: Buffered I/O operational\n");
    print("  - Objective-9C Typed Actors & Methods Operational\n");
    print("  - Objective-9C Lightweight Processes (rfork(RFMEM)) Operational\n");
    print("==================================================\n");

    int64 tick = 0;
    while(tick < 3) {
        tick = tick + 1;
        sup.heartbeat();
    }

    print("o9-supervisor: steady-state loop active (pid 1 staying alive)\n");
    /*
     * Keep PID 1 alive in one non-returning task.  Repeatedly spawning
     * and freeing short-lived task channels exposes a v64 use-after-free
     * in alt(): the result channel can be freed while the parent awaits.
     */
    Task<int64> idle = spawn raw_idle();
    idle.await();

}
