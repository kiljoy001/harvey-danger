#!/usr/bin/env python3
"""Start the Aspera desktop VM from a Harvey source checkout."""

import argparse
import os
from pathlib import Path
import shutil
import sys


ROOT = Path(__file__).resolve().parents[1]
LIVE = ROOT / "util/9vm/aspera_live.py"
BUILD = ROOT / "build"
REQUIRED_FILES = (
    ROOT / "util/9vm/9vm",
    BUILD / "harvey.32bit",
    BUILD / "libo9.a",
    BUILD / "libdraw.a",
    BUILD / "libmemdraw.a",
    BUILD / "libthread.a",
    BUILD / "lib9p.a",
    BUILD / "libauth.a",
    BUILD / "libauthsrv.a",
    BUILD / "libsec.a",
    BUILD / "libndb.a",
    BUILD / "libbio.a",
    BUILD / "libc.a",
)


def check() -> list[str]:
    problems = []
    for path in REQUIRED_FILES:
        if not path.is_file():
            problems.append(f"missing {path.relative_to(ROOT)}")
    if not LIVE.is_file():
        problems.append("missing util/9vm/aspera_live.py")
    o9_root = Path(os.environ.get("O9_REPO", ROOT.parent / "objective-9c")).expanduser().resolve()
    if not (o9_root / "o9c/o9c").is_file():
        problems.append(f"missing Objective-9C compiler at {o9_root / 'o9c/o9c'}")
    for command in ("clang", "ld.lld", "gcc", "sdl2-config"):
        if shutil.which(command) is None:
            problems.append(f"missing command {command}")
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        problems.append("/dev/kvm is unavailable to this user")
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY") \
            and os.environ.get("SDL_VIDEODRIVER") != "dummy":
        problems.append("no graphical display (DISPLAY or WAYLAND_DISPLAY)")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", choices=("start", "check"),
                        default="start")
    parser.add_argument("--smoke", action="store_true",
                        help="run the SDL input and notes smoke check, then exit")
    args = parser.parse_args()
    os.environ["O9_REPO"] = str(Path(os.environ.get(
        "O9_REPO", ROOT.parent / "objective-9c")).expanduser().resolve())
    problems = check()
    if problems:
        for problem in problems:
            print(f"aspera: {problem}", file=sys.stderr)
        print("Build instructions: util/9vm/PACKAGING.md", file=sys.stderr)
        return 1
    if args.command == "check":
        print("Aspera desktop VM is ready to start")
        return 0
    os.chdir(ROOT)
    command = [sys.executable, str(LIVE)]
    if args.smoke:
        command.append("--smoke")
    os.execv(sys.executable, command)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
