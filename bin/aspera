#!/usr/bin/env python3
"""Start the GEFS-backed Aspera VM or its graphical development preview."""

import argparse
import os
from pathlib import Path
import shutil
import sys


ROOT = Path(__file__).resolve().parents[1]
LIVE = ROOT / "util/9vm/aspera_live.py"
BUILD = ROOT / "build"
PREVIEW_FILES = (
    ROOT / "util/9vm/9vm",
    BUILD / "harvey.32bit",
    BUILD / "libo9.a",
    BUILD / "libdraw.a",
    BUILD / "libmemdraw.a",
    BUILD / "libthread.a",
    BUILD / "lib9p.a",
    BUILD / "libauth.a",
    BUILD / "libauthsrv.a",
    BUILD / "libsec.a",
    BUILD / "libndb.a",
    BUILD / "libbio.a",
    BUILD / "libc.a",
)
SYSTEM_FILES = (ROOT / "util/9vm/9vm", BUILD / "harvey.32bit")


def check(command: str, image: Path) -> list[str]:
    problems = []
    files = PREVIEW_FILES if command == "preview" else SYSTEM_FILES + (image,)
    for path in files:
        if not path.is_file():
            try:
                label = str(path.relative_to(ROOT))
            except ValueError:
                label = str(path)
            problems.append(f"missing {label}")
    if command == "preview":
        if not LIVE.is_file():
            problems.append("missing util/9vm/aspera_live.py")
        o9_root = Path(os.environ["O9_REPO"])
        if not (o9_root / "o9c/o9c").is_file():
            problems.append(f"missing Objective-9C compiler at {o9_root / 'o9c/o9c'}")
        for tool in ("clang", "ld.lld", "gcc", "sdl2-config"):
            if shutil.which(tool) is None:
                problems.append(f"missing command {tool}")
        if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY") \
                and os.environ.get("SDL_VIDEODRIVER") != "dummy":
            problems.append("no graphical display (DISPLAY or WAYLAND_DISPLAY)")
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        problems.append("/dev/kvm is unavailable to this user")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", choices=("start", "preview", "check"),
                        default="start")
    parser.add_argument("--image", type=Path, default=BUILD / "aspera-gefs.img",
                        help="GEFS disk image for start/check")
    parser.add_argument("--ram", type=int, default=1024,
                        help="guest memory in MiB for start (default: 1024)")
    parser.add_argument("--smoke", action="store_true",
                        help="run the graphical preview smoke check, then exit")
    args = parser.parse_args()
    if args.ram < 256 or args.ram > 65536:
        parser.error("--ram must be between 256 and 65536 MiB")
    if args.smoke and args.command != "preview":
        parser.error("--smoke requires the preview command")
    os.environ["O9_REPO"] = str(Path(os.environ.get(
        "O9_REPO", ROOT.parent / "objective-9c")).expanduser().resolve())
    mode = "preview" if args.command == "preview" else "start"
    image = args.image.expanduser().resolve()
    problems = check(mode, image)
    if problems:
        for problem in problems:
            print(f"aspera: {problem}", file=sys.stderr)
        print("Build instructions: util/9vm/PACKAGING.md", file=sys.stderr)
        return 1
    if args.command == "check":
        print("GEFS-backed Aspera VM is ready to start (console only)")
        return 0
    os.chdir(ROOT)
    if args.command == "start":
        print("Starting GEFS-backed Aspera VM; graphical desktop is not installed in this boot yet.",
              flush=True)
        vm = str(ROOT / "util/9vm/9vm")
        os.execv(vm, [vm, "-m", str(args.ram), "-gefs-image", str(image),
                      str(BUILD / "harvey.32bit")])
    command = [sys.executable, str(LIVE)]
    if args.smoke:
        command.append("--smoke")
    os.execv(sys.executable, command)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
