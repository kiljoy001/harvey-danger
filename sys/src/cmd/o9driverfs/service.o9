// A user-space 9P driver filesystem. The privileged launcher selects the
// backend files; clients only see names inside this service's view.
import "stdlib/view.o9";
import "stdlib/process.o9";
import "stdlib/file.o9";
import "stdlib/string.o9";
import "bytes.o9";

function DriverManagedArgsRaw(string generation, string slot) int64 {
    int64 out;
    c {
        char *g, *s, *p;

        out = 0;
        g = o9_string_cstr(generation);
        s = o9_string_cstr(slot);
        if(g != nil && s != nil && g[0] != 0 && s[0] != 0 &&
           strlen(g) <= 10 && strlen(s) <= 10){
            out = 1;
            for(p = g; *p != 0; p++)
                if(*p < '0' || *p > '9')
                    out = 0;
            for(p = s; *p != 0; p++)
                if(*p < '0' || *p > '9')
                    out = 0;
        }
        free(g);
        free(s);
    }
    return out;
}

function DriverExistsRaw(string path) int64 {
    int64 out;
    c {
        char *name;
        Dir *d;

        out = 0;
        name = o9_string_cstr(path);
        if(name != nil){
            d = dirstat(name);
            if(d != nil){
                out = 1;
                free(d);
            }
            free(name);
        }
    }
    return out;
}

function DriverReadRaw(string path) string {
    string out;
    c {
        char *name, *buf;
        int fd, n;

        out = nil;
        name = o9_string_cstr(path);
        if(name != nil){
            fd = open(name, OREAD);
            buf = malloc(65536);
            if(fd >= 0 && buf != nil){
                n = read(fd, buf, 65536);
                if(n > 0)
                    out = o9_string_new(buf, n);
            }
            if(fd >= 0)
                close(fd);
            free(buf);
            free(name);
        }
        if(out == nil)
            out = o9_string_new("", 0);
    }
    return out;
}

function DriverWriteRaw(string path, string data) int64 {
    int64 out;
    c {
        char *name;
        int fd;
        vlong n;

        out = -1;
        name = o9_string_cstr(path);
        if(name != nil){
            fd = open(name, OWRITE);
            if(fd >= 0){
                n = o9_string_len(data);
                if(n <= 65536)
                    out = write(fd, o9_string_data(data), n);
                close(fd);
            }
            free(name);
        }
    }
    return out;
}

function DriverManagedStopRaw(string statusRoot, string serviceName,
                              string generation) int64 {
    int64 out;
    c {
        char *root, *service, *gen, *path, text[16];
        int fd, n;

        out = -1;
        root = o9_string_cstr(statusRoot);
        service = o9_string_cstr(serviceName);
        gen = o9_string_cstr(generation);
        path = nil;
        if(root != nil && service != nil && gen != nil)
            path = smprint("%s/%s.%s.stop", root, service, gen);
        free(root);
        free(service);
        free(gen);
        if(path != nil){
            for(;;){
                fd = open(path, OREAD);
                if(fd >= 0){
                    n = read(fd, text, sizeof text);
                    close(fd);
                    if(n == 9 && memcmp(text, "shutdown\n", 9) == 0){
                        remove(path);
                        break;
                    }
                }
                sleep(25);
            }
            free(path);
            out = 0;
        }
    }
    return out;
}

class DriverFs {
    ViewController;
    private string[] names;
    private string[] backends;
    private int64 count;

    method DriverFs() { count = 0; }

    private method bool validName(string name) {
        if(len(name) == 0 || len(name) > 32) { return false; }
        int64 i = 0;
        while(i < len(name)) {
            Task<byte> ch = spawn BytesGetRaw(name, i);
            int64 c = ch.await();
            if(!((c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
                 (c >= 97 && c <= 122) || c == 45 || c == 95)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    method bool add(string name, string backend) {
        if(count >= 16 || !validName(name) || len(backend) < 2 ||
           len(backend) > 256 || cmp(backend, "/") == 0) { return false; }
        Task<byte> first = spawn BytesGetRaw(backend, 0);
        if(first.await() != 47) { return false; }
        Task<int64> exists = spawn DriverExistsRaw(backend);
        if(exists.await() == 0) { return false; }
        int64 i = 0;
        while(i < count) {
            if(cmp(names[i], name) == 0) { return false; }
            i = i + 1;
        }
        names[count] = cat(name, "");
        backends[count] = cat(backend, "");
        count = count + 1;
        return true;
    }

    method bool loadManaged(string serviceName) {
        if(!validName(serviceName)) { return false; }
        string path = cat(cat("/mnt/o9driverfs-config/", serviceName), ".tab");
        File config = new File(path);
        if(!config.exists() || config.size() <= 0 || config.size() > 8192) {
            return false;
        }
        string text = config.read();
        Task<int64> terminatedTask = spawn StringEndsWithRaw(text, "\n");
        Task<int64> linesTask = spawn StringCountRaw(text, "\n");
        bool terminated = terminatedTask.await() != 0;
        int64 lines = linesTask.await();
        if(!terminated || lines < 2 || lines > 17) { return false; }
        Task<string> headerTask = spawn StringFieldRaw(text, "\n", 0);
        if(cmp(headerTask.await(), "name\tbackend") != 0) { return false; }
        int64 row = 1;
        while(row < lines) {
            Task<string> lineTask = spawn StringFieldRaw(text, "\n", row);
            string line = lineTask.await();
            Task<string> nameTask = spawn StringFieldRaw(line, "\t", 0);
            Task<string> backendTask = spawn StringFieldRaw(line, "\t", 1);
            Task<string> extraTask = spawn StringFieldRaw(line, "\t", 2);
            string name = nameTask.await();
            string backend = backendTask.await();
            string extra = extraTask.await();
            if(len(name) == 0 || len(backend) == 0 || len(extra) != 0 ||
               !add(name, backend)) { return false; }
            row = row + 1;
        }
        return true;
    }

    method bool reportManagedReady(string statusRoot, string serviceName,
                                   string generation) {
        File marker = new File(cat(cat(cat(statusRoot, "/"), serviceName),
                                   cat(".", generation)));
        return marker.write("ready\n") == 0;
    }

    private method int64 findDriver(string path) {
        int64 i = 0;
        while(i < count) {
            if(cmp(path, cat(cat("drivers/", names[i]), "/data")) == 0) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    internal method FileTree display(string id, string caller) {
        FileTree tree = new FileTree();
        tree.text("protocol", "o9driverfs 1\n", false);
        tree.dir("drivers");
        int64 i = 0;
        while(i < count) {
            string base = cat("drivers/", names[i]);
            if(tree.dir(base) < 0 ||
               tree.live(cat(base, "/data"), true) < 0) { return nil; }
            i = i + 1;
        }
        return tree;
    }

    internal method string readText(string id, string path) {
        int64 index = findDriver(path);
        if(index < 0) { return ""; }
        Task<string> result = spawn DriverReadRaw(backends[index]);
        return result.await();
    }

    internal method int64 writeText(string id, string path, int64 offset,
                                   string data, bool truncate) {
        int64 index = findDriver(path);
        if(index < 0 || offset != 0 || len(data) > 65536) { return -1; }
        Task<int64> result = spawn DriverWriteRaw(backends[index], data);
        return result.await();
    }
}

main {
    Process process = new Process();
    DriverFs drivers = new DriverFs();
    bool managedMode = false;
    if(process.argc() == 5) {
        Task<int64> managedTask = spawn DriverManagedArgsRaw(process.arg(2),
                                                              process.arg(3));
        managedMode = managedTask.await() == 1;
    }
    if(managedMode) {
        if(drivers.loadManaged(process.arg(1))) {
            viewController(drivers);
            if(drivers.reportManagedReady(process.arg(4), process.arg(1),
                                          process.arg(2))) {
                Task<int64> stop = spawn DriverManagedStopRaw(process.arg(4),
                                                               process.arg(1),
                                                               process.arg(2));
                stop.await();
            } else {
                print("o9driverfs: could not report readiness\n");
            }
        } else {
            print("o9driverfs: invalid managed configuration\n");
        }
    } else if(process.argc() < 3 || process.argc() % 2 == 0) {
        print("usage: o9driverfs name /absolute/backend [name /absolute/backend ...]\n");
    } else {
        bool valid = true;
        int64 i = 1;
        while(i + 1 < process.argc()) {
            if(!drivers.add(process.arg(i), process.arg(i + 1))) {
                valid = false;
            }
            i = i + 2;
        }
        if(valid) {
            viewController(drivers);
            serve();
        } else {
            print("o9driverfs: invalid or duplicate driver\n");
        }
    }
}
