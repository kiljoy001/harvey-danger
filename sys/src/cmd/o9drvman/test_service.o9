import "stdlib/file.o9";
import "stdlib/namespace.o9";
import "stdlib/string.o9";
import "stdlib/time.o9";
import "service.o9";

class DriverManagerProbe {
    method int64 identity(int64 value) { return value; }
}

main {
    DriverManagerProbe probe = new DriverManagerProbe();
    DriverManager manager = new DriverManager();
    File managerStatus = new File("/mnt/o9drvman-status");
    bool ok = probe.identity(1) == 1 && managerStatus.mkdirAll() &&
              manager.service("DriverManagerProbe", "/mnt/o9drvman-status") &&
              manager.add("net0");
    File privateMount = new File("/mnt/o9drvman-private");
    File childMarker = new File("/build/o9drvman-child-started");
    childMarker.remove();
    ok = ok && privateMount.mkdirAll();
    ok = ok && manager.addProcess("probe", "/build/o9drvman-test-child");
    ok = ok && manager.addProcess("crash", "/build/o9drvman-test-child");
    ok = ok && manager.addProcess("faulty", "/build/o9drvman-test-child");
    ok = ok && manager.addProcess("stubborn", "/build/o9drvman-test-child");
    ok = ok && !manager.add("net0");
    ok = ok && !manager.add("../bad");
    if(!ok) { print("O9DRVMAN-FAIL setup\n"); }
    string started = manager.command("start net0 100");
    Task<int64> startText = spawn StringIndexOfRaw(started, "ok net0 starting 1");
    ok = ok && startText.await() >= 0;
    string stale = manager.command("ready net0 2 110");
    Task<int64> staleText = spawn StringIndexOfRaw(stale, "ignored net0 starting 1");
    ok = ok && staleText.await() >= 0;
    string ready = manager.command("ready net0 1 110");
    Task<int64> readyText = spawn StringIndexOfRaw(ready, "ok net0 running 1");
    ok = ok && readyText.await() >= 0;
    string progress = manager.command("progress net0 1 120 9");
    Task<int64> progressText = spawn StringIndexOfRaw(progress, "ok net0 running 1");
    ok = ok && progressText.await() >= 0;
    Task<int64> rowText = spawn StringIndexOfRaw(manager.table(),
        "net0\trunning\t1\t0\t1\t30120\t0\t9");
    ok = ok && rowText.await() >= 0;
    if(!ok) { print("O9DRVMAN-FAIL lifecycle\n"); }

    File mountpoint = new File("/mnt/o9drvman-test");
    ok = ok && mountpoint.mkdirAll();
    DriverManagerViews views = new DriverManagerViews(manager);
    viewController(views);
    File service = new File("/srv/DriverManagerProbe");
    int64 tries = 0;
    while(!service.exists() && tries < 80) {
        Task<int64> pause = spawn TimeSleepRaw(25);
        pause.await();
        tries = tries + 1;
    }
    Namespace mounts = new Namespace();
    bool posted = service.exists();
    bool rooted = mounts.root("/mnt");
    bool mounted = mounts.mountsrvReplace("/srv/DriverManagerProbe", "o9drvman-test", "");
    bool applied = mounts.apply();
    if(!posted) { print("O9DRVMAN-FAIL service-post\n"); }
    if(!rooted) { print("O9DRVMAN-FAIL service-root\n"); }
    if(!mounted) { print("O9DRVMAN-FAIL service-mount\n"); }
    if(!applied) { print("O9DRVMAN-FAIL service-apply\n"); }
    ok = ok && posted && rooted && mounted && applied;
    File protocol = new File("/mnt/o9drvman-test/view/protocol");
    File table = new File("/mnt/o9drvman-test/view/drivers.tab");
    File ctl = new File("/mnt/o9drvman-test/view/ctl");
    File result = new File("/mnt/o9drvman-test/view/result");
    bool protocolOk = cmp(protocol.read(), "o9drvman 1\n") == 0;
    if(!protocolOk) { print("O9DRVMAN-FAIL service-protocol\n"); }
    ok = ok && protocolOk;
    Task<int64> mountedRow = spawn StringIndexOfRaw(table.read(), "net0\trunning\t1");
    bool mountedRowOk = mountedRow.await() >= 0;
    if(!mountedRowOk) { print("O9DRVMAN-FAIL service-table\n"); }
    ok = ok && mountedRowOk;
    int64 wrote = ctl.append("exit net0 1 130\n");
    if(wrote != 16) { print("O9DRVMAN-FAIL service-write\n"); }
    ok = ok && wrote == 16;
    Task<int64> backoff = spawn StringIndexOfRaw(result.read(), "ok net0 backoff 1");
    bool backoffOk = backoff.await() >= 0;
    if(!backoffOk) { print("O9DRVMAN-FAIL service-result\n"); }
    ok = ok && backoffOk;
    if(!ok) { print("O9DRVMAN-FAIL mount\n"); }

    string processStart = "start probe 200\n";
    wrote = ctl.append(processStart);
    ok = ok && wrote == len(processStart);
    tries = 0;
    while(!childMarker.exists() && tries < 40) {
        Task<int64> childPause = spawn TimeSleepRaw(25);
        childPause.await();
        tries = tries + 1;
    }
    ok = ok && childMarker.exists() && cmp(childMarker.read(), "1") == 0;
    File leaked = new File("/mnt/o9drvman-private/o9drvman-test-child");
    ok = ok && !leaked.exists();

    string processReady = "ready probe 1 210\n";
    string processProgress = "progress probe 1 220 1\n";
    string processStop = "stop probe 230\n";
    ok = ok && ctl.append(processReady) == len(processReady);
    ok = ok && ctl.append(processProgress) == len(processProgress);
    ok = ok && ctl.append(processStop) == len(processStop);
    ok = ok && manager.reapOne() > 0;
    Task<int64> stopped = spawn StringIndexOfRaw(table.read(),
        "probe\tstopped\t1\t0\t0\t0\t0\t0\t0\t0");
    ok = ok && stopped.await() >= 0;
    if(!ok) { print("O9DRVMAN-FAIL probe\n"); }

    childMarker.remove();
    string crashStart = "start crash 300\n";
    ok = ok && ctl.append(crashStart) == len(crashStart);
    ok = ok && manager.reapOne() > 0;
    int64 retry = manager.value("crash", 5);
    ok = ok && retry > 0 && manager.value("crash", 2) == 1;
    ok = ok && manager.superviseOnce(retry) == 1;
    ok = ok && manager.value("crash", 1) == 2;
    ok = ok && manager.reapOne() > 0;
    ok = ok && manager.value("crash", 2) == 2;
    Task<int64> restarted = spawn StringIndexOfRaw(table.read(),
        "crash\tbackoff\t2\t2\t1");
    ok = ok && restarted.await() >= 0;
    string crashStop = "stop crash 301\n";
    ok = ok && ctl.append(crashStop) == len(crashStop);
    if(!ok) { print("O9DRVMAN-FAIL crash\n"); }

    File faultyHealth = new File("/mnt/o9drvman-status/faulty.1.health");
    File faultyReady = new File("/mnt/o9drvman-status/faulty.1");
    string faultyStart = "start faulty 450\n";
    ok = ok && ctl.append(faultyStart) == len(faultyStart);
    tries = 0;
    while((!faultyHealth.exists() || !faultyReady.exists()) && tries < 40) {
        Task<int64> faultyPause = spawn TimeSleepRaw(25);
        faultyPause.await();
        tries = tries + 1;
    }
    bool faultyFiles = faultyHealth.exists() && faultyReady.exists();
    int64 faultySupervise = manager.superviseOnce(451);
    int64 faultyState = manager.value("faulty", 0);
    int64 faultyReap = manager.reapOne();
    string faultyTable = table.read();
    Task<int64> faultyRow = spawn StringIndexOfRaw(faultyTable,
        "faulty\tbackoff\t1\t1\t1\t0\t701\t0\t0\t0\tfailed\t1\t1\t0\t0\t0\t1\t1\t0\trestart\tio-timeout");
    bool faultyMatched = faultyRow.await() >= 0;
    if(!faultyFiles) { print("O9DRVMAN-FAIL health-files\n"); }
    if(faultySupervise != 0) { print("O9DRVMAN-FAIL health-supervise\n"); }
    if(faultyState != 4) { print("O9DRVMAN-FAIL health-state\n"); }
    if(faultyReap <= 0) { print("O9DRVMAN-FAIL health-reap\n"); }
    if(!faultyMatched) {
        print("O9DRVMAN-FAIL health-row\n");
        print(faultyTable);
    }
    ok = ok && faultyFiles && faultySupervise == 0 && faultyState == 4 &&
         faultyReap > 0 && faultyMatched;
    string faultyStop = "stop faulty 452\n";
    ok = ok && ctl.append(faultyStop) == len(faultyStop);
    if(!ok) { print("O9DRVMAN-FAIL health\n"); }

    string stubbornStart = "start stubborn 500\n";
    string stubbornReady = "ready stubborn 1 510\n";
    string stubbornStop = "stop stubborn 520\n";
    bool stubbornStarted = ctl.append(stubbornStart) == len(stubbornStart);
    bool stubbornReadied = ctl.append(stubbornReady) == len(stubbornReady);
    bool stubbornStopped = ctl.append(stubbornStop) == len(stubbornStop);
    int64 stopDeadline = manager.value("stubborn", 4);
    int64 stubbornSupervise = manager.superviseOnce(stopDeadline);
    int64 stubbornReap = manager.reapOne();
    string stubbornTable = table.read();
    Task<int64> forcedStopped = spawn StringIndexOfRaw(stubbornTable,
        "stubborn\tstopped\t1\t0\t0\t0\t0\t0\t0\t0");
    bool stubbornMatched = forcedStopped.await() >= 0;
    if(!stubbornStarted) { print("O9DRVMAN-FAIL stubborn-start\n"); }
    if(!stubbornReadied) { print("O9DRVMAN-FAIL stubborn-ready\n"); }
    if(!stubbornStopped) { print("O9DRVMAN-FAIL stubborn-stop\n"); }
    if(stopDeadline <= 520) { print("O9DRVMAN-FAIL stubborn-deadline\n"); }
    if(stubbornSupervise != 0) { print("O9DRVMAN-FAIL stubborn-supervise\n"); }
    if(stubbornReap <= 0) { print("O9DRVMAN-FAIL stubborn-reap\n"); }
    if(!stubbornMatched) {
        print("O9DRVMAN-FAIL stubborn-row\n");
        print(stubbornTable);
    }
    ok = ok && stubbornStarted && stubbornReadied && stubbornStopped &&
         stopDeadline > 520 && stubbornSupervise == 0 && stubbornReap > 0 &&
         stubbornMatched;
    if(!ok) { print("O9DRVMAN-FAIL stubborn\n"); }
    mounts.unmount("/mnt/o9drvman-test");
    mounts.close();
    childMarker.remove();
    managerStatus.remove();
    privateMount.remove();
    if(ok) { print("O9DRVMAN-9P PASS\n"); }
    else {
        print("O9DRVMAN-9P FAIL\n");
        print(manager.table());
    }
}
