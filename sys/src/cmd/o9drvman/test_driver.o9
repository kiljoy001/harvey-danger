import "stdlib/file.o9";
import "stdlib/process.o9";
import "stdlib/string.o9";
import "stdlib/time.o9";

function DriverPrivateMountRaw() int64 {
    int64 out;
    c {
        out = bind("/build", "/mnt/o9drvman-private", MREPL);
    }
    return out;
}

main {
    Process process = new Process();
    File marker = new File("/build/o9drvman-child-started");
    Task<int64> isolated = spawn DriverPrivateMountRaw();
    string generation = process.arg(2);
    int64 isolatedResult = isolated.await();
    int64 markerResult = -1;
    if(isolatedResult >= 0) { markerResult = marker.write(generation); }
    if(markerResult == 0) {
        if(cmp(process.arg(3), "4") == 0) {
            string base = cat(cat(cat(process.arg(4), "/"), process.arg(1)),
                              cat(".", generation));
            File health = new File(cat(base, ".health"));
            File ready = new File(base);
            string report = cat("o9health/1\t", cat(generation,
                "\t1\t1\tfailed\t0\t0\t0\t1\t1\t0\trestart\tio-timeout\n"));
            if(health.write(report) == 0) { ready.write("ready\n"); }
            Time clock = new Time();
            clock.sleep(10000);
        } else if(cmp(process.arg(3), "5") == 0) {
            Time clock = new Time();
            clock.sleep(10000);
        } else if(cmp(process.arg(3), "2") != 0) {
            File stop = new File(cat(cat(cat(process.arg(4), "/"),
                                         process.arg(1)),
                                     cat(".", cat(generation, ".stop"))));
            while(!stop.exists()) {
                Task<int64> pause = spawn TimeSleepRaw(25);
                pause.await();
            }
        }
    }
}
