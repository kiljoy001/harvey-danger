// welcome.o9 - first-run tutorial window for the Aspera desktop.
//
// Compiled by o9c and linked against Plan 9 libdraw.  It runs in the Rio
// window that the startup script creates for it, draws the tour, and returns
// so that `exec rc` in the same window can take over as the shell.  The page
// text is passed in from O9; the C island is the libdraw binding.

function WelcomeRun(int64 pages,
                    string t0, string a0, string b0, string c0, string d0,
                    string t1, string a1, string b1, string c1, string d1,
                    string t2, string a2, string b2, string c2, string d2,
                    string t3, string a3, string b3, string c3, string d3) int64 {
    int64 ok;
    c {
        extern int welcome_resized;

        char *title[4], *line1[4], *line2[4], *line3[4], *line4[4];
        Image *bg = nil, *accent = nil, *ink = nil, *muted = nil;
        Image *soft = nil, *dot = nil;
        Event e;
        u32 kind;
        int w, h, i, x, page, running, redraw;
        Point p;

        title[0] = o9_string_data(t0); line1[0] = o9_string_data(a0);
        line2[0] = o9_string_data(b0); line3[0] = o9_string_data(c0);
        line4[0] = o9_string_data(d0);
        title[1] = o9_string_data(t1); line1[1] = o9_string_data(a1);
        line2[1] = o9_string_data(b1); line3[1] = o9_string_data(c1);
        line4[1] = o9_string_data(d1);
        title[2] = o9_string_data(t2); line1[2] = o9_string_data(a2);
        line2[2] = o9_string_data(b2); line3[2] = o9_string_data(c2);
        line4[2] = o9_string_data(d2);
        title[3] = o9_string_data(t3); line1[3] = o9_string_data(a3);
        line2[3] = o9_string_data(b3); line3[3] = o9_string_data(c3);
        line4[3] = o9_string_data(d3);

        if(getenv("wsys") == nil){
            fprint(2, "welcome: no window system (run from Rio)\n");
            goto wout;
        }
        if(initdraw(nil, nil, "Objective-9c v0.4.0 Tour") < 0){
            fprint(2, "welcome: initdraw: %r\n");
            goto wout;
        }
        einit(Emouse|Ekeyboard);

        bg = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xFFFFFFFF);
        accent = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x1F6F78FF);
        ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x202020FF);
        muted = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x505050FF);
        soft = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xE2E2E2FF);
        dot = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xD6D6D6FF);
        if(bg == nil || accent == nil || ink == nil || muted == nil ||
           soft == nil || dot == nil)
            goto wout;

        page = 0;
        running = 1;
        redraw = 1;
        while(running){
            if(redraw){
                w = Dx(screen->r);
                h = Dy(screen->r);
                draw(screen, screen->r, bg, nil, ZP);
                draw(screen, Rect(screen->r.min.x, screen->r.min.y,
                                  screen->r.min.x + w, screen->r.min.y + 54),
                     accent, nil, ZP);
                string(screen, Pt(screen->r.min.x + 20, screen->r.min.y + 17),
                       bg, ZP, font, title[page]);

                p = Pt(screen->r.min.x + 24, screen->r.min.y + 86);
                string(screen, p, ink, ZP, font, line1[page]);
                p.y += 28;
                string(screen, p, ink, ZP, font, line2[page]);
                p.y += 28;
                string(screen, p, muted, ZP, font, line3[page]);
                p.y += 28;
                string(screen, p, muted, ZP, font, line4[page]);

                draw(screen, Rect(screen->r.min.x, screen->r.min.y + h - 44,
                                  screen->r.min.x + w, screen->r.min.y + h - 43),
                     soft, nil, ZP);
                x = 24;
                for(i = 0; i < pages; i++){
                    draw(screen, Rect(screen->r.min.x + x,
                                      screen->r.min.y + h - 26,
                                      screen->r.min.x + x + 10,
                                      screen->r.min.y + h - 16),
                         i == page ? accent : dot, nil, ZP);
                    x += 16;
                }
                string(screen, Pt(screen->r.min.x + 110,
                                  screen->r.min.y + h - 30),
                       muted, ZP, font, "click / Enter: next   Esc: close");
                flushimage(display, 1);
                redraw = 0;
            }

            kind = event(&e);
            if(welcome_resized){
                welcome_resized = 0;
                if(getwindow(display, Refnone) < 0)
                    running = 0;
                redraw = 1;
            } else if(kind == Ekeyboard){
                if(e.kbdc == 27 || e.kbdc == 'q' || e.kbdc == 'Q'){
                    running = 0;
                } else if(e.kbdc == '\n' || e.kbdc == '\r' ||
                          e.kbdc == ' ' || e.kbdc == 'n' || e.kbdc == 'N'){
                    page = (page + 1) % pages;
                    redraw = 1;
                }
            } else if(kind == Emouse){
                if(e.mouse.buttons & 4){
                    running = 0;
                } else if(e.mouse.buttons & 1){
                    page = (page + 1) % pages;
                    redraw = 1;
                }
            }
        }
        ok = 1;

    wout:
        if(bg) freeimage(bg);
        if(accent) freeimage(accent);
        if(ink) freeimage(ink);
        if(muted) freeimage(muted);
        if(soft) freeimage(soft);
        if(dot) freeimage(dot);
        if(display != nil)
            closedisplay(display);
    }
    return ok;
}

main {
    Task<int64> run = spawn WelcomeRun(4,
        "Objective-9c v0.4.0",
        "Welcome to Objective-9c running on the Harvey microkernel.",
        "This entire interactive tour is written in welcome.o9.",
        "Objective-9c brings actors, CSP channels, and 9P services to C.",
        "Click or press Enter to explore the language tour.",

        "Concurrency & Memory",
        "Actors run concurrently and communicate via typed CSP channels.",
        "Zero-copy o9_string_data() delivers 0-allocation string passing.",
        "Scoped DataFrames provide linear scratchpads with O(1) scope resets.",
        "Full C sandwich: transparently embed raw C blocks inside O9.",

        "In-Guest o9c Compiler",
        "The o9c compiler is installed right here at /bin/o9c.",
        "Tour source is staged at /sys/src/welcome.o9.",
        "Try compiling:  o9c /sys/src/welcome.o9 > welcome.c",
        "Actors dynamically export 9P filesystem trees under /mnt/o9.",

        "Explore System & Shell",
        "Every window is an isolated process in the Rio window system.",
        "The shell is rc. Try:  cat /sys/src/welcome.o9    o9c --version",
        "Your browser clipboard syncs automatically via /n/host/clip.",
        "Press Esc or close this window to drop into the rc shell.");
    run.await();
}
