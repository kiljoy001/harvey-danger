// A small Objective-9C client. Its pixels live in a private offscreen surface.
import "canvas.o9";
import "window.o9";

function AsperaNoteLoadRaw(string path) string {
    string out;
    c {
        char *name, buf[8192];
        Dir *d;
        int fd, n, total;

        out = nil;
        name = o9_string_cstr(path);
        if(name != nil){
            d = dirstat(name);
            if(d != nil && d->length >= 0 && d->length <= sizeof buf){
                fd = open(name, OREAD);
                if(fd >= 0){
                    total = 0;
                    while(total < d->length){
                        n = read(fd, buf + total, d->length - total);
                        if(n <= 0)
                            break;
                        total += n;
                    }
                    if(total == d->length)
                        out = o9_string_new(buf, total);
                    close(fd);
                }
            }
            free(d);
            free(name);
        }
        if(out == nil)
            out = o9_string_new("", 0);
    }
    return out;
}

function AsperaNoteSaveRaw(string path, string value) int64 {
    int64 out;
    c {
        char *name;
        int fd, n, total, length;

        out = -1;
        length = o9_string_len(value);
        name = o9_string_cstr(path);
        if(name != nil && length >= 0 && length <= 8192){
            fd = create(name, OWRITE, 0600);
            if(fd >= 0){
                total = 0;
                while(total < length){
                    n = write(fd, o9_string_data(value) + total, length - total);
                    if(n <= 0)
                        break;
                    total += n;
                }
                if(total == length)
                    out = total;
                close(fd);
            }
        }
        free(name);
    }
    return out;
}

function AsperaNoteRemoveRaw(string path) int64 {
    int64 out;
    c {
        char *name = o9_string_cstr(path);
        out = name != nil && remove(name) == 0;
        free(name);
    }
    return out;
}

function AsperaNoteEditRaw(string value, int64 key) string {
    string out;
    c {
        char *s;
        vlong n;

        s = o9_string_cstr(value);
        n = o9_string_len(value);
        out = nil;
        if(s != nil && n >= 0 && n <= 8192){
            if(key == 8 && n > 0){
                n--;
                while(n > 0 && ((uchar)s[n] & 0xc0) == 0x80)
                    n--;
                out = o9_string_new(s, n);
            }else if(key == 13 && n < 8192){
                s[n] = '\n';
                out = o9_string_new(s, n + 1);
            }else if(key >= 32 && key <= 126 && n < 8192){
                s[n] = (char)key;
                out = o9_string_new(s, n + 1);
            }else
                out = o9_string_new(s, n);
        }
        free(s);
        if(out == nil)
            out = o9_string_new("", 0);
    }
    return out;
}

function AsperaNoteLineCountRaw(string value, int64 columns) int64 {
    int64 lines;
    c {
        char *s;
        int row, col, i;

        lines = 1;
        s = o9_string_cstr(value);
        if(s != nil && columns > 0 && columns <= 240){
            row = col = 0;
            for(i = 0; s[i] != '\0' && i < 8192; i++){
                if(s[i] == '\n'){
                    row++;
                    col = 0;
                }else if(s[i] != '\r'){
                    if(col >= columns){
                        row++;
                        col = 0;
                    }
                    col++;
                }
            }
            lines = row + 1;
        }
        free(s);
    }
    return lines;
}

function AsperaNoteVisualLineRaw(string value, int64 columns, int64 wanted) string {
    string out;
    c {
        char *s, buf[256];
        int row, col, i;

        out = nil;
        s = o9_string_cstr(value);
        if(s != nil && columns > 0 && columns < (int)sizeof buf &&
           wanted >= 0 && wanted < 8192){
            row = col = 0;
            for(i = 0; s[i] != '\0' && i < 8192; i++){
                if(s[i] == '\n'){
                    if(row == wanted)
                        break;
                    row++;
                    col = 0;
                }else if(s[i] != '\r'){
                    if(col >= columns){
                        if(row == wanted)
                            break;
                        row++;
                        col = 0;
                    }
                    if(row == wanted)
                        buf[col] = s[i];
                    col++;
                }
            }
            if(row == wanted){
                buf[col] = '\0';
                out = o9_string_new(buf, col);
            }
        }
        free(s);
        if(out == nil)
            out = o9_string_new("", 0);
    }
    return out;
}

function AsperaNoteRenderRaw(int64 ptr, string value, int64 flags) int64 {
    c {
        #undef FONT8X14_H
        #include "font8x14.h"

        typedef struct {
            int width;
            int height;
            u32 *pixels;
        } AsperaBuffer;

        AsperaBuffer *b = (AsperaBuffer*)ptr;
        char *s = o9_string_cstr(value);

        #define ASPERA_CHAR(ch_val, cx, cy, col) do { \
            unsigned char _ch = (unsigned char)(ch_val); \
            if(_ch >= 32 && _ch <= 126){ \
                int _gi = _ch - 32; \
                for(int _r = 0; _r < 14; _r++){ \
                    int _py = (cy) + _r; \
                    if(_py >= 0 && _py < b->height){ \
                        unsigned char _bits = font8x14_data[_gi][_r]; \
                        u32 *_scan = b->pixels + _py * b->width; \
                        for(int _ci = 0; _ci < 8; _ci++){ \
                            int _px = (cx) + _ci; \
                            if(_px >= 0 && _px < b->width && (_bits & (0x80 >> _ci))) \
                                _scan[_px] = (col); \
                        } \
                    } \
                } \
            } \
        } while(0)

        #define ASPERA_TEXT(str_lit, tx, ty, col) do { \
            const char *_str = (str_lit); \
            int _cx = (tx), _cy = (ty); \
            u32 _c = (col); \
            for(int _idx = 0; _str[_idx] != '\0'; _idx++){ \
                ASPERA_CHAR(_str[_idx], _cx, _cy, _c); \
                _cx += 8; \
            } \
        } while(0)

        if(b != nil && b->pixels != nil && b->width > 0 && b->height > 0){
            int width = b->width;
            int height = b->height;
            int columns = (width - 16) / 8;
            int rows = (height - 44) / 16;
            int total = width * height;
            for(int i = 0; i < total; i++)
                b->pixels[i] = 0x101820;
            int barH = 24 < height ? 24 : height;
            for(int j = 0; j < barH; j++){
                u32 *scan = b->pixels + j * width;
                for(int i = 0; i < width; i++)
                    scan[i] = 0x253747;
            }
            ASPERA_TEXT("Aspera Notes  |  Ctrl+S saves", 8, 5, 0xffd382);
            if(flags & 1)
                ASPERA_TEXT("*", width - 16, 5, 0xffd382);
            if(flags & 2)
                ASPERA_TEXT("Save failed", width - 112, 5, 0xff7766);
            if(s != nil && columns > 0 && columns <= 240 && rows > 0){
                int row = 0, col = 0;
                for(int i = 0; s[i] != '\0' && i < 8192; i++){
                    if(s[i] == '\n'){
                        row++;
                        col = 0;
                    }else if(s[i] != '\r'){
                        if(col >= columns){
                            row++;
                            col = 0;
                        }
                        col++;
                    }
                }
                int lines = row + 1;
                int start = lines - rows;
                if(start < 0)
                    start = 0;
                row = col = 0;
                for(int i = 0; s[i] != '\0' && i < 8192; i++){
                    if(s[i] == '\n'){
                        row++;
                        col = 0;
                        if(row >= start + rows)
                            break;
                    }else if(s[i] != '\r'){
                        if(col >= columns){
                            row++;
                            col = 0;
                            if(row >= start + rows)
                                break;
                        }
                        if(row >= start && row < start + rows)
                            ASPERA_CHAR(s[i], 8 + col * 8, 30 + (row - start) * 16, 0xe4eaf0);
                        col++;
                    }
                }
            }
        }
        #undef ASPERA_CHAR
        #undef ASPERA_TEXT
        free(s);
    }
    return 0;
}

class AsperaNote {
    private WindowActor window;
    private AsperaCanvas surface;
    private string contents;
    private string path;
    private bool dirty;
    private bool saveError;

    method AsperaNote(WindowActor owner, string filename) {
        window = owner;
        path = filename;
        surface = new AsperaCanvas(owner.contentWidth(), owner.contentHeight());
        contents = "";
        Task<string> loaded = spawn AsperaNoteLoadRaw(path);
        contents = loaded.await();
        dirty = false;
        saveError = false;
        if(surface.ready()) {
            owner.attachContent(surface);
            render();
        }
    }

    method bool ready() { return surface.ready(); }
    method string text() { return contents; }
    method bool isDirty() { return dirty; }

    method bool key(int64 value) {
        if(value != 8 && value != 13 && (value < 32 || value > 126)) {
            return false;
        }
        Task<string> edited = spawn AsperaNoteEditRaw(contents, value);
        string next = edited.await();
        if(cmp(next, contents) == 0) { return false; }
        contents = next;
        dirty = true;
        saveError = false;
        render();
        return true;
    }

    method bool save() {
        Task<int64> saved = spawn AsperaNoteSaveRaw(path, contents);
        if(saved.await() != len(contents)) {
            saveError = true;
            render();
            return false;
        }
        dirty = false;
        saveError = false;
        render();
        return true;
    }

    method void render() {
        if(surface.ready()) {
            int64 flags = 0;
            if(dirty) { flags = flags + 1; }
            if(saveError) { flags = flags + 2; }
            Task<int64> renderTask = spawn AsperaNoteRenderRaw(surface.bufferAddress(), contents, flags);
            renderTask.await();
        }
    }

    method void close() { surface.close(); }
}
