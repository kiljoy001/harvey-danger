// Main Demonstration and Test Harness for o9aspera Window Manager
// Tests Enlightenment-inspired features: Shading, Pinning, Magnetic Snapping, Pager, and Themes.

import "stdlib/collections.o9";
import "canvas.o9";
import "theme.o9";
import "window.o9";
import "desktop.o9";

main {
    print("==================================================\n");
    print("  Aspera: Enlightenment-Inspired Window Manager\n");
    print("  Objective-9C First-Class Themed Desktop\n");
    print("==================================================\n");

    // 1. Initialize Desktop Compositor with E16 Theme
    E16Theme e16 = new E16Theme();
    DesktopCompositor desk = new DesktopCompositor(1024, 768, e16);
    Theme curTheme = desk.getTheme();
    AsperaCanvas canvas = new AsperaCanvas(1024, 768);

    print("[aspera] Desktop initialized (1024x768, 2x2 workspaces, theme: ", curTheme.name(), ")\n");

    // 2. Create sample windows
    WindowActor w1 = desk.createWindow("Terminal 1 [rc]", 60, 80, 480, 320);
    WindowActor w2 = desk.createWindow("Editor [sam]", 300, 150, 520, 400);

    print("[aspera] Created Window 1: id=", w1.id(), " '", w1.getTitle(), "' rect=(", w1.x(), ",", w1.y(), ",", w1.width(), ",", w1.height(), ")\n");
    print("[aspera] Created Window 2: id=", w2.id(), " '", w2.getTitle(), "' rect=(", w2.x(), ",", w2.y(), ",", w2.width(), ",", w2.height(), ")\n");

    // Test DrawScrollbar widget integration
    DrawScrollbar sb1 = w1.getScrollbar();
    print("[aspera-scrollbar] Window 1 DrawScrollbar: vertical=", sb1.isVertical(), " min=", sb1.minimum(), " max=", sb1.maximum(), " val=", sb1.value(), "\n");

    // 3. Test Hit-Testing on E16 Theme buttons
    int64 bw = e16.borderThickness();
    int64 th = e16.titlebarHeight();
    int64 hitTitle = w1.hitTest(w1.x() + bw + 20, w1.y() + bw + 10);
    print("[aspera-hit] Titlebar click hit result = ", hitTitle, " (expected 2: hitTitle)\n");

    // Render baseline E16 desktop snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_e16.ppm");
    print("[o9aspera-render] Exported E16 desktop snapshot to build/desktop_e16.ppm\n");

    // 4. Test Enlightenment Accordion Shading
    print("[o9aspera-shade] Testing Window Shading on '", w1.getTitle(), "'...\n");
    int64 origH = w1.height();
    w1.toggleShade();
    int64 shadedH = w1.visibleHeight();
    print("  [Shaded]   visibleHeight = ", shadedH, " (titleHeight=", th, " + 2*bw=", bw*2, " = ", th + bw*2, ")\n");

    // Render Shaded Accordion snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_shaded.ppm");
    print("[o9aspera-render] Exported Accordion Shaded snapshot to build/desktop_shaded.ppm\n");

    w1.toggleShade();
    int64 restoredH = w1.visibleHeight();
    print("  [Restored] visibleHeight = ", restoredH, " (original was ", origH, ")\n");

    if(shadedH == th + bw * 2 && restoredH == origH) {
        print("  [PASS] Enlightenment Accordion Shading verified\n");
    } else {
        print("  [FAIL] Shading height mismatch\n");
    }

    // 5. Test Desktop Pinning (Sticky Windows)
    print("[o9aspera-sticky] Testing Desktop Pinning (Sticky across workspaces)...\n");
    print("  Initial sticky state: ", w1.sticky(), "\n");
    w1.toggleSticky();
    print("  Toggled sticky state: ", w1.sticky(), "\n");

    // Switch workspace from (0,0) to (1,0)
    desk.switchDesktop(1, 0);
    print("  Switched to Workspace (", desk.getCurDeskX(), ",", desk.getCurDeskY(), ") [id=", desk.currentDesktopId(), "]\n");
    print("  Window 1 visible on new desktop: ", (w1.sticky() || w1.getDesktop() == desk.currentDesktopId()), "\n");
    print("  Window 2 visible on new desktop: ", (w2.sticky() || w2.getDesktop() == desk.currentDesktopId()), "\n");

    // Render Virtual Workspace Pager snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_pager.ppm");
    print("[o9aspera-render] Exported Virtual Workspace Pager snapshot to build/desktop_pager.ppm\n");

    if(w1.sticky() && !(w2.sticky() || w2.getDesktop() == desk.currentDesktopId())) {
        print("  [PASS] Sticky window persistence verified\n");
    }

    // Switch back to (0,0)
    desk.switchDesktop(0, 0);

    // 6. Test Enlightenment Magnetic Snapping
    print("[o9aspera-snap] Testing Magnetic Snapping...\n");
    // Place window close to left edge (e.g. x=8, within snap margin 16)
    print("  Requesting move to (8, 6) near screen boundary...\n");
    desk.snapMove(w1, 8, 6);
    print("  Magnetically snapped position: (", w1.x(), ",", w1.y(), ")\n");

    if(w1.x() == 0 && w1.y() == 0) {
        print("  [PASS] Magnetic boundary snap verified (snapped to 0,0)\n");
    }

    // Test snap to neighbor window edge
    print("  Moving Window 2 near Window 1 right edge...\n");
    // Window 1 is at x=0, width=480, right edge = 480.
    // Place Window 2 at x=488 (within snap margin 16 of Window 1's right edge 480)
    desk.snapMove(w2, 488, 0);
    print("  Window 2 snapped position: (", w2.x(), ",", w2.y(), ") [Target edge was 480]\n");

    if(w2.x() == 480 && w2.y() == 0) {
        print("  [PASS] Neighbor window magnetic alignment verified\n");
    }

    // 7. Test First-Class Dynamic Theme Switching at Runtime
    print("[o9aspera-theme] Testing Dynamic Theme Switching...\n");
    Win95Theme win95 = new Win95Theme();
    desk.setDefaultTheme(win95);
    Theme tWin = desk.getTheme();
    Theme tWin1 = w1.getTheme();
    print("  Active Theme switched to: ", tWin.name(), " (border=", tWin.borderThickness(), " title=", tWin.titlebarHeight(), ")\n");
    print("  Window 1 border updated to: ", tWin1.borderThickness(), "\n");

    // Render Win95 desktop snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_win95.ppm");
    print("[o9aspera-render] Exported Win95 desktop snapshot to build/desktop_win95.ppm\n");

    Plan9Theme p9 = new Plan9Theme();
    desk.setDefaultTheme(p9);
    Theme tP9 = desk.getTheme();
    Theme tP91 = w1.getTheme();
    print("  Active Theme switched to: ", tP9.name(), " (border=", tP9.borderThickness(), " title=", tP9.titlebarHeight(), ")\n");
    print("  Window 1 border updated to: ", tP91.borderThickness(), "\n");

    // Render Plan9 desktop snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_plan9.ppm");
    print("[o9aspera-render] Exported Plan9 desktop snapshot to build/desktop_plan9.ppm\n");

    NeXTTheme next = new NeXTTheme();
    desk.setDefaultTheme(next);
    Theme tNext = desk.getTheme();
    print("  Active Theme switched to: ", tNext.name(), " (border=", tNext.borderThickness(), " title=", tNext.titlebarHeight(), ")\n");

    // Render NeXT desktop snapshot
    desk.renderAll(canvas);
    canvas.savePPM("build/desktop_next.ppm");
    print("[o9aspera-render] Exported NeXT desktop snapshot to build/desktop_next.ppm\n");

    canvas.close();

    print("\n==================================================\n");
    print("  All Enlightenment-Inspired Aspera Features Verified!\n");
    print("  - Declarative Theme Engine (E16, Win95, Plan9, NeXT)\n");
    print("  - Accordion Shading (Collapsible Titlebar)\n");
    print("  - Desktop Pinning (Sticky Across Workspaces)\n");
    print("  - Magnetic Edge and Neighbor Snapping\n");
    print("  - Live 2D Workspace Pager\n");
    print("==================================================\n");
}
