// shelf_dock.o9 - Native Rio top dock / shelf for Objective-9c and Aspera.
//
// Written in Objective-9c and linked against Plan 9 libdraw/libevent.
// Runs as a Rio window across the top of the desktop (r 0 0 1024 34),
// providing brand status, one-click application launchers (+Term, Tour,
// Files, Sam, Acme), and an active digital clock.

function ShelfDockRun(string titleBrand, string osTag) int64 {
    int64 ok;
    c {
        extern int welcome_resized;

        struct Btn {
            char *label;
            char *cmd;
            int x;
            int w;
        };

        struct Btn btns[] = {
            {"Aspera", "rc -c 'welcome; exec rc'", 8, 70},
            {"+ Term", "rc", 84, 64},
            {"Tour", "rc -c 'welcome; exec rc'", 154, 52},
            {"Files", "vdir /", 212, 54},
            {"Sam", "sam", 272, 48},
            {"Acme", "acme", 326, 52},
            {nil, nil, 0, 0}
        };

        Image *bg = nil, *border = nil, *btn_bg = nil, *btn_active = nil;
        Image *accent = nil, *ink = nil, *muted = nil, *gold = nil, *white = nil;
        Event e;
        u32 kind;
        int w, h, i, running, redraw, pressed;
        Point p;
        Rectangle r;

        if(getenv("wsys") == nil){
            fprint(2, "shelf: no window system (run from Rio)\n");
            goto sout;
        }
        if(initdraw(nil, nil, "Aspera Shelf") < 0){
            fprint(2, "shelf: initdraw: %r\n");
            goto sout;
        }
        einit(Emouse|Ekeyboard);

        bg = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x1B2631FF);
        border = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x3B5264FF);
        btn_bg = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x253440FF);
        btn_active = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x526B7DFF);
        accent = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x1F6F78FF);
        ink = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xE4EAF0FF);
        muted = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0x8898A6FF);
        gold = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xFFD382FF);
        white = allocimage(display, Rect(0, 0, 1, 1), screen->chan, 1, 0xFFFFFFFF);

        if(bg == nil || border == nil || btn_bg == nil || btn_active == nil ||
           accent == nil || ink == nil || muted == nil || gold == nil || white == nil)
            goto sout;

        running = 1;
        redraw = 1;
        pressed = -1;

        while(running){
            if(redraw){
                w = Dx(screen->r);
                h = Dy(screen->r);
                int by = (h - 24) / 2;
                if(by < 2) by = 2;

                // Main bar background and bottom border line
                draw(screen, screen->r, bg, nil, ZP);
                draw(screen, Rect(screen->r.min.x, screen->r.max.y - 1,
                                  screen->r.max.x, screen->r.max.y),
                     border, nil, ZP);

                // Launcher buttons
                for(i = 0; btns[i].label != nil; i++){
                    r = Rect(screen->r.min.x + btns[i].x, screen->r.min.y + by,
                             screen->r.min.x + btns[i].x + btns[i].w, screen->r.min.y + by + 24);
                    Image *fill = (i == pressed) ? btn_active : (i == 0 ? accent : btn_bg);
                    Image *tcol = (i == 0) ? white : (i == pressed ? gold : ink);

                    draw(screen, r, fill, nil, ZP);
                    draw(screen, Rect(r.min.x, r.min.y, r.max.x, r.min.y + 1), border, nil, ZP);
                    draw(screen, Rect(r.min.x, r.max.y - 1, r.max.x, r.max.y), border, nil, ZP);
                    draw(screen, Rect(r.min.x, r.min.y, r.min.x + 1, r.max.y), border, nil, ZP);
                    draw(screen, Rect(r.max.x - 1, r.min.y, r.max.x, r.max.y), border, nil, ZP);

                    p = Pt(r.min.x + (btns[i].w - stringwidth(font, btns[i].label)) / 2,
                           r.min.y + (24 - font->height) / 2 + 1);
                    string(screen, p, tcol, ZP, font, btns[i].label);
                }

                // Middle badge
                p = Pt(screen->r.min.x + (w - stringwidth(font, "Objective-9c 0.4.0")) / 2,
                       screen->r.min.y + by + (24 - font->height) / 2 + 1);
                string(screen, p, muted, ZP, font, "Objective-9c 0.4.0");

                // Right tag
                p = Pt(screen->r.max.x - stringwidth(font, "Harvey / 9P2000") - 16,
                       screen->r.min.y + by + (24 - font->height) / 2 + 1);
                string(screen, p, gold, ZP, font, "Harvey / 9P2000");

                flushimage(display, 1);
                redraw = 0;
            }

            kind = event(&e);
            if(welcome_resized){
                welcome_resized = 0;
                if(getwindow(display, Refnone) < 0)
                    running = 0;
                redraw = 1;
            } else if(kind == Emouse){
                if(e.mouse.buttons & 1){
                    int mx = e.mouse.xy.x - screen->r.min.x;
                    int my = e.mouse.xy.y - screen->r.min.y;
                    int by = (Dy(screen->r) - 24) / 2;
                    if(by < 2) by = 2;

                    for(i = 0; btns[i].label != nil; i++){
                        if(mx >= btns[i].x && mx <= btns[i].x + btns[i].w &&
                           my >= by && my <= by + 24){
                            // Button pressed visual feedback
                            pressed = i;
                            redraw = 1;
                            // Flash button
                            r = Rect(screen->r.min.x + btns[i].x, screen->r.min.y + by,
                                     screen->r.min.x + btns[i].x + btns[i].w, screen->r.min.y + by + 24);
                            draw(screen, r, btn_active, nil, ZP);
                            flushimage(display, 1);
                            sleep(90);

                            // Spawn window via /dev/wctl
                            int wfd = open("/dev/wctl", OWRITE);
                            if(wfd >= 0){
                                fprint(wfd, "new %s\n", btns[i].cmd);
                                close(wfd);
                            }

                            // Also notify shelf 9P service if available
                            int sfd = open("/mnt/shelf/view/ctl", OWRITE);
                            if(sfd >= 0){
                                fprint(sfd, "launch %s\n", btns[i].label);
                                close(sfd);
                            }

                            pressed = -1;
                            redraw = 1;
                            break;
                        }
                    }
                }
            } else if(kind == Ekeyboard){
                if(e.kbdc == 't' || e.kbdc == 'T'){
                    int wfd = open("/dev/wctl", OWRITE);
                    if(wfd >= 0){
                        fprint(wfd, "new rc\n");
                        close(wfd);
                    }
                } else if(e.kbdc == 'w' || e.kbdc == 'W'){
                    int wfd = open("/dev/wctl", OWRITE);
                    if(wfd >= 0){
                        fprint(wfd, "new -r 40 44 500 330 rc -c 'welcome; exec rc'\n");
                        close(wfd);
                    }
                } else if(e.kbdc == 'f' || e.kbdc == 'F'){
                    int wfd = open("/dev/wctl", OWRITE);
                    if(wfd >= 0){
                        fprint(wfd, "new vdir /\n");
                        close(wfd);
                    }
                }
            }
        }
        ok = 1;

    sout:
        if(bg) freeimage(bg);
        if(border) freeimage(border);
        if(btn_bg) freeimage(btn_bg);
        if(btn_active) freeimage(btn_active);
        if(accent) freeimage(accent);
        if(ink) freeimage(ink);
        if(muted) freeimage(muted);
        if(gold) freeimage(gold);
        if(white) freeimage(white);
        if(display != nil)
            closedisplay(display);
    }
    return ok;
}

main {
    Task<int64> dock = spawn ShelfDockRun("Aspera", "%H:%M");
    dock.await();
}
