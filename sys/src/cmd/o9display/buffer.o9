import "string.o9";
import "bytes.o9";
// Native XRGB8888 image storage. Pixel bytes live in a C-side store owned by
// the display service; only small control strings and integer handles cross
// actor boundaries. This keeps scanout independent of actor payload limits.
function DisplayPixelRaw(int64 op, int64 slot, int64 a, int64 b, int64 c,
                         string data) int64 {
    int64 out;
    c {
        static uchar *buf[256];
        static vlong len[256];
        static vlong wid[256];
        static vlong hei[256];
        static Lock pixlock;
        vlong i, size, count, rowbytes, r, off;
        uchar *p;
        char *path;
        int fd;

        out = -1;
        lock(&pixlock);
        if(op == 0) {
            if(a > 0 && b > 0 && a <= 1920 && b <= 1080) {
                for(slot = 0; slot < 256 && buf[slot] != nil; slot++)
                    ;
                if(slot < 256) {
                    size = a * b * 4;
                    p = malloc(size);
                    if(p != nil) {
                        memset(p, 0, size);
                        buf[slot] = p;
                        len[slot] = size;
                        wid[slot] = a;
                        hei[slot] = b;
                        out = slot;
                    }
                }
            }
        } else if(op == 1) {
            if(slot >= 0 && slot < 256 && buf[slot] != nil) {
                free(buf[slot]);
                buf[slot] = nil;
                len[slot] = 0;
                wid[slot] = 0;
                hei[slot] = 0;
                out = 0;
            }
        } else if(slot >= 0 && slot < 256 && buf[slot] != nil) {
            if(op == 2) {
                if(a >= 0 && a <= 0xffffff) {
                    p = buf[slot];
                    for(i = 0; i < len[slot]; i += 4) {
                        p[i] = a;
                        p[i+1] = a >> 8;
                        p[i+2] = a >> 16;
                        p[i+3] = 255;
                    }
                    out = len[slot];
                }
            } else if(op == 3) {
                count = o9_string_len(data);
                if(a >= 0 && count <= 65536 && a + count <= len[slot]) {
                    memmove(buf[slot] + a, o9_string_data(data), count);
                    out = count;
                }
            } else if(op == 4) {
                path = o9_string_cstr(data);
                if(path != nil) {
                    fd = open(path, OWRITE);
                    free(path);
                    if(fd >= 0) {
                        out = 0;
                        rowbytes = wid[slot] * 4;
                        p = buf[slot];
                        for(r = 0; r < hei[slot]; r++) {
                            off = (b + r) * c + a * 4;
                            if(seek(fd, off, 0) < 0 ||
                               write(fd, p + r * rowbytes, rowbytes) != rowbytes) {
                                out = -1;
                                break;
                            }
                            out += rowbytes;
                        }
                        close(fd);
                    }
                }
            } else if(op == 5) {
                count = b;
                if(a >= 0 && count >= 0 && a + count <= len[slot]) {
                    p = malloc(count > 0 ? count : 1);
                    if(p != nil) {
                        memmove(p, buf[slot] + a, count);
                        out = (vlong)p;
                    }
                }
            }
        }
        unlock(&pixlock);
    }
    return out;
}

function DisplayPixelStringRaw(int64 ptr, int64 len) string {
    string out;
    c {
        out = nil;
        if(ptr != 0) {
            out = o9_string_new((char*)ptr, len);
            free((void*)ptr);
        }
        if(out == nil)
            out = o9_string_new("", 0);
    }
    return out;
}

class DisplayBuffer {
    private int64 bufferId;
    private int64 ownerId;
    private int64 pixelWidth;
    private int64 pixelHeight;
    private int64 pixelSlot;

    method DisplayBuffer(int64 id, int64 owner, int64 width, int64 height) {
        bufferId = id;
        ownerId = owner;
        pixelWidth = width;
        pixelHeight = height;
        pixelSlot = -1;
        if(id > 0 && owner > 0 && width > 0 && height > 0 &&
           width <= 512 && height <= 512) {
            Task<int64> alloc = spawn DisplayPixelRaw(0, 0, width, height, 0, "");
            pixelSlot = alloc.take();
        }
    }

    method bool valid() {
        return pixelSlot >= 0 && bufferId > 0 && ownerId > 0 &&
               pixelWidth > 0 && pixelHeight > 0;
    }

    method int64 id() { return bufferId; }
    method int64 owner() { return ownerId; }
    method int64 width() { return pixelWidth; }
    method int64 height() { return pixelHeight; }
    method int64 size() {
        if(!valid()) { return 0; }
        return pixelWidth * pixelHeight * 4;
    }

    method string data() {
        if(!valid()) { return ""; }
        Task<int64> read = spawn DisplayPixelRaw(5, pixelSlot, 0, size(), 0, "");
        int64 ptr = read.take();
        if(ptr < 0) { return ""; }
        Task<string> text = spawn DisplayPixelStringRaw(ptr, size());
        return text.take();
    }

    method bool reset(int64 id, int64 owner, int64 width, int64 height) {
        if(bufferId != 0 || id <= 0 || owner <= 0 ||
           width <= 0 || height <= 0 || width > 512 || height > 512) {
            return false;
        }
        Task<int64> alloc = spawn DisplayPixelRaw(0, 0, width, height, 0, "");
        int64 slot = alloc.take();
        if(slot < 0) { return false; }
        bufferId = id;
        ownerId = owner;
        pixelWidth = width;
        pixelHeight = height;
        pixelSlot = slot;
        return true;
    }

    method bool zero() {
        if(!valid()) { return false; }
        Task<int64> fill = spawn DisplayPixelRaw(2, pixelSlot, 0, 0, 0, "");
        return fill.take() == size();
    }

    method bool write(int64 offset, string bytes) {
        if(!valid() || offset < 0 || len(bytes) > 65536 ||
           offset > size() || len(bytes) > size() - offset) {
            return false;
        }
        Task<int64> patch = spawn DisplayPixelRaw(3, pixelSlot, offset, 0, 0, bytes);
        return patch.take() == len(bytes);
    }

    method bool clear(int64 rgb) {
        if(!valid() || rgb < 0 || rgb > 16777215) { return false; }
        Task<int64> fill = spawn DisplayPixelRaw(2, pixelSlot, rgb, 0, 0, "");
        return fill.take() == size();
    }

    // Present from the actor that owns the C pixel store.
    method int64 present(string path, int64 x, int64 y, int64 stride) {
        Task<int64> writeTask = spawn DisplayPixelRaw(4, pixelSlot, x, y, stride, path);
        return writeTask.take();
    }

    method void close() {
        if(pixelSlot >= 0) {
            Task<int64> release = spawn DisplayPixelRaw(1, pixelSlot, 0, 0, 0, "");
            release.take();
            pixelSlot = -1;
        }
        bufferId = 0;
        ownerId = 0;
        pixelWidth = 0;
        pixelHeight = 0;
    }
}
