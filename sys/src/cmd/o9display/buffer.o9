import "string.o9";
import "bytes.o9";
// Keep each upload to one new snapshot. A DisplayBuffer actor is reused for
// every write; helper tasks are consumed with take() after one result.
function DisplayBufferBlankRaw(int64 size) string {
    string out;
    c {
        out = nil;
        if(size > 0 && size <= 512*512*4) {
            out = o9_string_new(nil, size);
            if(out != nil)
                memset(o9_string_data(out), 0, size);
        }
    }
    return out;
}

function DisplayBufferPatchRaw(string current, int64 offset, string patch) string {
    string out;
    c {
        vlong total, count;
        char *dst, *src;

        out = nil;
        total = o9_string_len(current);
        count = o9_string_len(patch);
        if(current != nil && patch != nil && offset >= 0 &&
           count <= 65536 && offset <= total && count <= total-offset) {
            out = o9_string_new(nil, total);
            if(out != nil) {
                dst = o9_string_data(out);
                src = o9_string_data(current);
                memmove(dst, src, offset);
                memmove(dst+offset, o9_string_data(patch), count);
                memmove(dst+offset+count, src+offset+count,
                        total-offset-count);
            }
        }
    }
    return out;
}

function DisplayBufferFillRaw(int64 count, int64 rgb) string {
    string out;
    c {
        vlong i, size;
        uchar *dst;

        out = nil;
        if(count > 0 && count <= 512*512 && rgb >= 0 && rgb <= 0xffffff) {
            size = count*4;
            out = o9_string_new(nil, size);
            if(out != nil) {
                dst = (uchar*)o9_string_data(out);
                for(i = 0; i < size; i += 4) {
                    dst[i] = rgb;
                    dst[i+1] = rgb >> 8;
                    dst[i+2] = rgb >> 16;
                    dst[i+3] = 255;
                }
            }
        }
    }
    return out;
}

// Native XRGB8888 image storage. The 9P service owns buffers, including
// offscreen images; surfaces only refer to these buffers when presenting.
class DisplayBuffer {
    private int64 bufferId;
    private int64 ownerId;
    private int64 pixelWidth;
    private int64 pixelHeight;
    private string pixels;

    method DisplayBuffer(int64 id, int64 owner, int64 width, int64 height) {
        bufferId = id;
        ownerId = owner;
        pixelWidth = width;
        pixelHeight = height;
        pixels = "";
        if(id > 0 && owner > 0 && width > 0 && height > 0 &&
           width <= 512 && height <= 512) {
            Task<string> blank = spawn DisplayBufferBlankRaw(width * height * 4);
            pixels = blank.take();
        }
    }

    method bool valid() {
        return len(pixels) == pixelWidth * pixelHeight * 4 &&
               bufferId > 0 && ownerId > 0;
    }

    method int64 id() { return bufferId; }
    method int64 owner() { return ownerId; }
    method int64 width() { return pixelWidth; }
    method int64 height() { return pixelHeight; }
    method int64 size() { return len(pixels); }
    // The reader owns its snapshot after subsequent writes replace pixels.
    method string data() { return cat(pixels, ""); }

    method bool reset(int64 id, int64 owner, int64 width, int64 height) {
        if(bufferId != 0 || id <= 0 || owner <= 0 ||
           width <= 0 || height <= 0 || width > 512 || height > 512) {
            return false;
        }
        Task<string> blank = spawn DisplayBufferBlankRaw(width * height * 4);
        string next = blank.take();
        if(len(next) != width * height * 4) { return false; }
        pixels.dispose();
        pixels = next;
        bufferId = id;
        ownerId = owner;
        pixelWidth = width;
        pixelHeight = height;
        return true;
    }

    method bool zero() {
        if(!valid()) { return false; }
        Task<string> blank = spawn DisplayBufferBlankRaw(pixelWidth * pixelHeight * 4);
        string next = blank.take();
        if(len(next) != len(pixels)) { return false; }
        pixels.dispose();
        pixels = next;
        return valid();
    }

    // A write is one 9P chunk. Reject oversized chunks and out-of-range
    // offsets before forming a new immutable snapshot.
    method bool write(int64 offset, string bytes) {
        int64 count = len(bytes);
        int64 total = len(pixels);
        if(!valid() || offset < 0 || count > 65536 ||
           offset > total || count > total - offset) { return false; }
        Task<string> patchTask = spawn DisplayBufferPatchRaw(pixels, offset, bytes);
        string next = patchTask.take();
        if(len(next) != total) { return false; }
        pixels.dispose();
        pixels = next;
        return len(pixels) == total;
    }

    method bool clear(int64 rgb) {
        if(!valid() || rgb < 0 || rgb > 16777215) { return false; }
        Task<string> fill = spawn DisplayBufferFillRaw(pixelWidth * pixelHeight, rgb);
        string next = fill.take();
        if(len(next) != len(pixels)) { return false; }
        pixels.dispose();
        pixels = next;
        return len(pixels) == pixelWidth * pixelHeight * 4;
    }

    method void close() {
        pixels.dispose();
        pixels = "";
        bufferId = 0;
        ownerId = 0;
    }
}
